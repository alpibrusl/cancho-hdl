{
  "$schema": "https://alpibrusl/cancho-hdl/tests/behavioral/scenarios.schema.json (TODO-not-normative)",
  "description": "Behavioral-roundtrip corpus. One op script per scenario, mirroring the Python scenarios in oracle/legacy/tools/sim/scenarios/ step for step. Each script is executed against the reference model (oracle/legacy/tools/sim/op_runner.py), the compiled C harness (tests/behavioral/c_device.c) and eventually the SystemVerilog module; the traces must match. There are no expected values here — expectations live in the reference model (the oracle); refusal expectations are part of the op stream itself (an op the oracle refuses produces ERR <code> in both engines' traces).",
  "scenarios": [
    {
      "contract": "examples/uart-contract/uart.chw",
      "name": "uart/rw_basic",
      "ops": [
        "R CTRL",
        "Wf CTRL ENABLE 1",
        "Rf CTRL ENABLE",
        "R CTRL",
        "Wf CTRL BAUD_DIV 128",
        "Rf CTRL BAUD_DIV",
        "Rf CTRL ENABLE",
        "RESET",
        "R CTRL"
      ]
    },
    {
      "contract": "examples/uart-contract/uart.chw",
      "name": "uart/enum_field",
      "ops": [
        "Wf CTRL PARITY 0",
        "Rf CTRL PARITY",
        "Wf CTRL PARITY 1",
        "Rf CTRL PARITY",
        "Wf CTRL PARITY 2",
        "Rf CTRL PARITY",
        "Wf CTRL PARITY 3"
      ]
    },
    {
      "contract": "examples/uart-contract/uart.chw",
      "name": "uart/access_kinds",
      "ops": [
        "W STATUS 0xFFFFFFFF",
        "Wf STATUS RX_READY 1",
        "R ICR",
        "R STATUS"
      ]
    },
    {
      "contract": "examples/uart-contract/uart.chw",
      "name": "uart/interrupt_lifecycle",
      "ops": [
        "PS rx_ready",
        "IP rx_ready",
        "PE rx_ready",
        "Df STATUS RX_READY 1",
        "Df ISR RX 1",
        "PS rx_ready",
        "IP rx_ready",
        "Wf IER RX_EN 1",
        "PE rx_ready",
        "PC rx_ready",
        "IP rx_ready"
      ]
    },
    {
      "contract": "examples/uart-contract/uart.chw",
      "name": "uart/wo_w1c_semantics",
      "ops": [
        "W ICR 0xFFFFFFFF",
        "R ICR"
      ]
    },
    {
      "contract": "examples/simple-dma/dma.chw",
      "name": "dma/w1c_clear",
      "ops": [
        "D IRQ_STATUS 0xFFFFFFFF",
        "R IRQ_STATUS",
        "W IRQ_STATUS 0x1",
        "R IRQ_STATUS"
      ]
    },
    {
      "contract": "examples/simple-dma/dma.chw",
      "name": "dma/cpu_owned",
      "ops": [
        "DW TxDescriptor next_ptr 0xDEADBEEF",
        "DR TxDescriptor next_ptr",
        "DW TxDescriptor data_ptr 0x1000",
        "DR TxDescriptor data_ptr"
      ]
    },
    {
      "contract": "examples/simple-dma/dma.chw",
      "name": "dma/device_owned",
      "ops": [
        "DW TxDescriptor done_flag 1",
        "DR TxDescriptor done_flag"
      ]
    },
    {
      "contract": "examples/simple-dma/dma.chw",
      "name": "dma/rx_descriptor",
      "ops": [
        "DW RxDescriptor next_ptr 0x2000",
        "DR RxDescriptor next_ptr",
        "DW RxDescriptor data_ptr 0x3000",
        "DW RxDescriptor length 1024",
        "DR RxDescriptor data_ptr",
        "DR RxDescriptor length",
        "DR RxDescriptor error_flag"
      ]
    },
    {
      "contract": "examples/simple-dma/dma.chw",
      "name": "dma/irq_tx_complete",
      "ops": [
        "IP tx_complete",
        "D IRQ_STATUS 0x1",
        "IP tx_complete",
        "Wf IRQ_ENABLE DONE_EN 1",
        "PE tx_complete",
        "PC tx_complete",
        "IP tx_complete"
      ]
    },
    {
      "contract": "examples/simple-dma/dma.chw",
      "name": "dma/reset",
      "ops": [
        "W RING_BASE 0x12345678",
        "DW TxDescriptor next_ptr 0xCAFEBABE",
        "W IRQ_STATUS 0x2",
        "RESET",
        "R RING_BASE",
        "DR TxDescriptor next_ptr",
        "R IRQ_STATUS"
      ]
    }
  ]
}
