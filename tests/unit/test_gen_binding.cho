// test_gen_binding.cho -- the cancho-binding generator (src/gen_binding.cho, docs/cancho-port.md 26): the
// declarations of a small contract, the accessors each register kind allows, the Python tool's two refusals, the
// names it cannot carry, and an IR a checker would have refused.
//
//     cancho test tests/unit/test_gen_binding.cho <the library> --std

import std.buffer;
import std.bytes;
import std.test;
import chw.front;
import chw.gen_binding;
import chw.ir as model;

fn has[&b, &n](haystack: &b buffer.Buffer, needle: &n [byte]) -> [] bool {
    return bytes.find(buffer.bytes(haystack), needle) >= 0;
}

fn as_int(b: bool) -> [] int {
    if b {
        return 1;
    }
    return 0;
}

// The declarations (or the refusal text) of the text-form contract `text`, and its status.
fn run[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (buffer.Buffer, int) {
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, got);
        let (out, st) = gen_binding.generate(heap, text, "t.chw", q);
        got = out;
        status = st;
    }
    model.drop(heap, ir);
    return (got, status);
}

fn uart() -> [] &static [byte] {
    return "register-block UartRegs @ 0x4000_0000, width 32, little-endian {\n    register CTRL @ 0x00 : RW, reset 0x0 {\n        field ENABLE : bits [0]\n        field PARITY : bits [1..2] enum { None=0, Even=1, Odd=2 }\n        field BAUD : bits [8..15]\n    }\n    register ISR @ 0x0c : RO {\n        field RX : bits [0]\n    }\n    register ICR @ 0x10 : W1C {\n        field RX : bits [0]\n    }\n    interrupt rx_ready from ISR.RX {\n        number 5\n        source @ ISR.RX\n        enable @ CTRL.ENABLE\n        status @ ISR.RX\n        clear : W1C @ ICR.RX\n    }\n}\n";
}

fn test_a_contract_is_written_as_the_python_tool_writes_it[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, uart());
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "// Generated by cancho-hdl from t.chw. Do not edit.\n\nmodule uart_regs {\n    foreign block UartRegs @ 0x40000000 : u32;\n\n"));
        test.assert(has(o, "    // chw:UartRegs.register.CTRL.field.ENABLE\n    fn ctrl_enable() -> bool;\n    fn ctrl_enable_set(v: bool);\n"));
        test.assert(has(o, "    fn ctrl_parity_get() -> Parity;\n    fn ctrl_parity_set(v: Parity);\n"));
        test.assert(has(o, "    fn ctrl_baud_get() -> u32;\n    fn ctrl_baud_set(v: u32);\n"));
        test.assert(has(o, "    fn isr_rx() -> bool;\n"));
        test.assert(has(o, "    fn icr_rx_clear();\n"));
        test.assert(has(o, "\n    // chw:UartRegs.interrupt.rx_ready\n    capability UartRegsRxReady\n    fn rx_ready_arm();\n    fn rx_ready_status() -> bool;\n    fn rx_ready_clear();\n}\n"));
        test.assert(has(o, "}\n\nenum Parity { None, Even, Odd }\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_each_register_kind_has_the_accessors_it_allows[&h](heap: &!h Heap) -> [heap] int {
    let head = "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : ";
    let tail = " {\n        field F : bits [0]\n    }\n}\n";
    var k = 0;
    while k < 8 {
        var kind = "RO";
        var get = true;
        var clear = false;
        var set = false;
        if k == 1 {
            kind = "RC";
        }
        if k == 2 {
            kind = "WO";
            get = false;
            set = true;
        }
        if k == 3 {
            kind = "RW";
            set = true;
        }
        if k == 4 {
            kind = "W1C";
            get = false;
            clear = true;
        }
        if k == 5 {
            kind = "W0C";
            get = false;
            clear = true;
        }
        if k == 6 {
            kind = "W1S";
            get = false;
            set = true;
        }
        if k == 7 {
            kind = "W0S";
            get = false;
            set = true;
        }
        var src = buffer.append(heap, buffer.empty(heap, 128), head);
        src = buffer.append(heap, src, kind);
        src = buffer.append(heap, src, tail);
        borrow src as &sr in {
            let (out, st) = run(heap, buffer.bytes(sr));
            test.assert_eq(st, 0);
            borrow out as &o in {
                test.assert_eq(as_int(has(o, "    fn r_f() -> bool;\n")), as_int(get));
                test.assert_eq(as_int(has(o, "    fn r_f_clear();\n")), as_int(clear));
                test.assert_eq(as_int(has(o, "    fn r_f_set(v: bool);\n")), as_int(set));
            }
            buffer.drop(heap, out);
        }
        buffer.drop(heap, src);
        k = k + 1;
    }
    return 0;
}

fn test_a_getter_of_a_wide_field_carries_get_and_a_one_bit_field_is_bool[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RO {\n        field One : bits [3]\n        field Two : bits [4..5]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "    fn r_one() -> bool;\n"));
        test.assert(has(o, "    fn r_two_get() -> u32;\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_names_are_snake_cased_and_pascal_cased_as_the_python_tool_does[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block HTTPServer2Name @ 0x0, width 32, little-endian {\n    register Reg2X @ 0x0 : RO {\n        field FldA : bits [0]\n    }\n    interrupt a_b from Reg2X.FldA {\n        number 1\n        source @ Reg2X.FldA\n        enable @ Reg2X.FldA\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "module http_server2_name {"));
        test.assert(has(o, "    fn reg2_x_fld_a() -> bool;\n"));
        test.assert(has(o, "capability HttpServer2NameAB\n"));
        test.assert(has(o, "    fn a_b_arm();\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_an_interrupt_declares_only_the_linkages_it_has[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RO {\n        field F : bits [0]\n    }\n    interrupt only_status from R.F {\n        number 1\n        source @ R.F\n        status @ R.F\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "    fn only_status_status() -> bool;\n"));
        test.assert(bytes.find(buffer.bytes(o), "only_status_arm") < 0);
        test.assert(bytes.find(buffer.bytes(o), "only_status_clear") < 0);
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_block_with_no_interrupt_has_no_blank_line_before_the_close[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RO {\n        field F : bits [0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "    fn r_f() -> bool;\n}\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_two_enum_fields_with_one_name_and_one_label_list_declare_one_enum[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register A @ 0x0 : RW {\n        field Mode : bits [0..1] enum { X=0, Y=1 }\n    }\n    register C @ 0x4 : RW {\n        field Mode : bits [0..1] enum { X=0, Y=1 }\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "\nenum Mode { X, Y }\n"));
        let first = bytes.find(buffer.bytes(o), "enum Mode");
        test.assert(first >= 0);
        test.assert(bytes.find(buffer.bytes(o)[first + 9..len(buffer.bytes(o))], "enum Mode") < 0);
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_two_enum_fields_with_one_name_and_different_label_lists_are_refused[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register A @ 0x0 : RW {\n        field Mode : bits [0..1] enum { X=0, Y=1 }\n    }\n    register C @ 0x4 : RW {\n        field Mode : bits [0..1] enum { X=0, Z=1 }\n    }\n}\n");
    test.assert_eq(st, gen_binding.status_refused());
    borrow out as &o in {
        test.assert(has(o, "two enum fields named 'Mode' carry different label sets; refusing to collide the type Mode"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_the_same_labels_in_another_order_are_a_different_list[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register A @ 0x0 : RW {\n        field Mode : bits [0..1] enum { X=0, Y=1 }\n    }\n    register C @ 0x4 : RW {\n        field Mode : bits [0..1] enum { Y=1, X=0 }\n    }\n}\n");
    test.assert_eq(st, gen_binding.status_refused());
    buffer.drop(heap, out);
    return 0;
}

fn test_two_names_that_pascal_to_one_type_collide[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register A @ 0x0 : RW {\n        field tx_en : bits [0..1] enum { X=0 }\n    }\n    register C @ 0x4 : RW {\n        field TxEn : bits [0..1] enum { Y=0 }\n    }\n}\n");
    test.assert_eq(st, gen_binding.status_refused());
    borrow out as &o in {
        test.assert(has(o, "two enum fields named 'TxEn' carry different label sets; refusing to collide the type TxEn"));
    }
    buffer.drop(heap, out);
    return 0;
}

// ---- an IR built by hand: what a checked contract never reaches ----------------------------------------------------

// Ten pieces of text in one source, in this order, each a span of the IR.
fn piece(k: int) -> [] &static [byte] {
    if k == 0 {
        return "B";
    }
    if k == 1 {
        return "0x40";
    }
    if k == 2 {
        return "R";
    }
    if k == 3 {
        return "RW";
    }
    if k == 4 {
        return "f";
    }
    if k == 5 {
        return "e";
    }
    if k == 6 {
        return "i";
    }
    if k == 7 {
        return "d";
    }
    if k == 8 {
        return "g";
    }
    return "DEVICE";
}

fn layout[&h, &b](heap: &!h Heap, which: int, bad: &b [byte]) -> [heap] buffer.Buffer {
    var s = buffer.empty(heap, 64);
    var k = 0;
    while k < 10 {
        if k == which {
            s = buffer.append(heap, s, bad);
        } else {
            s = buffer.append(heap, s, piece(k));
        }
        k = k + 1;
    }
    return s;
}

fn start_of(which: int, bad_len: int, k: int) -> [] int {
    var at = 0;
    var j = 0;
    while j < k {
        if j == which {
            at = at + bad_len;
        } else {
            at = at + len(piece(j));
        }
        j = j + 1;
    }
    return at;
}

fn end_of(which: int, bad_len: int, k: int) -> [] int {
    return start_of(which, bad_len, k + 1);
}

// The status and text of an IR with one register, one enum field with one label, one interrupt and one DMA buffer
// with one device-owned field, named by the pieces. `width` and `path` are the block's and the banner's.
fn full_case[&h, &b, &p](heap: &!h Heap, which: int, bad: &b [byte], width: int, path: &p [byte]) -> [heap] (buffer.Buffer, int) {
    let src = layout(heap, which, bad);
    let n = len(bad);
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: start_of(which, n, 0), name_e: end_of(which, n, 0), base_s: start_of(which, n, 1), base_e: end_of(which, n, 1), width: width, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_field(heap, ir, model.Field { name_s: start_of(which, n, 4), name_e: end_of(which, n, 4), lsb: 0, msb: 1, has_enum: true, enum_first: 0, enum_n: 1, cons_s: 0 - 1, cons_e: 0 });
    ir = model.add_entry(heap, ir, model.Entry { name_s: start_of(which, n, 5), name_e: end_of(which, n, 5), value: 0 });
    ir = model.add_reg(heap, ir, model.Reg { name_s: start_of(which, n, 2), name_e: end_of(which, n, 2), off_s: 0, off_e: 0, kind_s: start_of(which, n, 3), kind_e: end_of(which, n, 3), reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 1 });
    ir = model.add_intr(heap, ir, model.Intr { name_s: start_of(which, n, 6), name_e: end_of(which, n, 6), number: 3, source: model.no_ref(), enable: model.no_ref(), status: model.no_ref(), clear: model.no_ref(), clear_kind_s: 0 - 1, clear_kind_e: 0, order: model.note(0, 2) });
    ir = model.add_buf(heap, ir, model.Buf { name_s: start_of(which, n, 7), name_e: end_of(which, n, 7), first: 0, n: 1 });
    ir = model.add_dfield(heap, ir, model.Dmaf { name_s: start_of(which, n, 8), name_e: end_of(which, n, 8), off_s: 0, off_e: 0, owner_s: start_of(which, n, 9), owner_e: end_of(which, n, 9), align: 0 - 1, coherent: 0 - 1, written_as: 0 - 1, cons_s: 0 - 1, cons_e: 0, order: 0 });
    var text = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow src as &sr in {
        borrow ir as &q in {
            buffer.drop(heap, text);
            let (o, s) = gen_binding.generate(heap, buffer.bytes(sr), path, q);
            text = o;
            status = s;
        }
    }
    buffer.drop(heap, src);
    model.drop(heap, ir);
    return (text, status);
}

fn test_the_layout_itself_is_declarations[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 0 - 1, "", 32, "t.chw");
    test.assert_eq(status, 0);
    borrow text as &o in {
        test.assert(has(o, "    foreign block B @ 0x40 : u32;\n"));
        test.assert(has(o, "    fn r_f_get() -> F;\n"));
        test.assert(has(o, "    capability BI\n    fn i_arm();\n"));
        test.assert(has(o, "    buffer d {\n"));
        test.assert(has(o, "        // no setter: DEVICE-owned (the field is the device's to write)\n"));
        test.assert(has(o, "\nenum F { e }\n"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn refused_with[&h, &w](heap: &!h Heap, which: int, phrase: &w [byte]) -> [heap] int {
    let (text, status) = full_case(heap, which, "a\\u0041", 32, "t.chw");
    test.assert_eq(status, gen_binding.status_refused());
    borrow text as &o in {
        test.assert(has(o, phrase));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_block_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 0, "the block name");
}

fn test_a_register_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 2, "the register name");
}

fn test_a_field_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 4, "the field name");
}

fn test_an_enum_label_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 5, "the enum label");
}

fn test_an_interrupt_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 6, "the interrupt name");
}

fn test_a_dma_buffer_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 7, "the DMA buffer name");
}

fn test_a_dma_field_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 8, "the DMA field name");
}

fn test_a_non_ascii_source_path_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 0 - 1, "", 32, "café.chw");
    test.assert_eq(status, gen_binding.status_refused());
    borrow text as &o in {
        test.assert(has(o, "the source path"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_an_access_kind_with_no_mapping_is_refused_with_the_python_tools_words[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 3, "XX", 32, "t.chw");
    test.assert_eq(status, gen_binding.status_refused());
    borrow text as &o in {
        test.assert(has(o, "register kind 'XX' has no cancho accessor mapping"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_device_owned_field_has_no_setter_and_any_other_owner_has_one[&h](heap: &!h Heap) -> [heap] int {
    let (cpu, st) = full_case(heap, 9, "CPU", 32, "t.chw");
    test.assert_eq(st, 0);
    borrow cpu as &o in {
        test.assert(has(o, "        fn g() -> u32;\n        fn g_set(v: u32);\n"));
        test.assert(bytes.find(buffer.bytes(o), "no setter") < 0);
    }
    buffer.drop(heap, cpu);
    let (dev, st2) = full_case(heap, 9, "DEVICE", 32, "t.chw");
    test.assert_eq(st2, 0);
    borrow dev as &d in {
        test.assert(bytes.find(buffer.bytes(d), "g_set") < 0);
    }
    buffer.drop(heap, dev);
    return 0;
}

fn test_a_negative_bus_width_is_internal_not_a_type[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 0 - 1, "", 0 - 8, "t.chw");
    test.assert_eq(status, gen_binding.status_internal());
    buffer.drop(heap, text);
    return 0;
}

fn test_a_base_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 1, "nope", 32, "t.chw");
    test.assert_eq(status, gen_binding.status_internal());
    buffer.drop(heap, text);
    return 0;
}

fn test_a_base_past_2_to_the_60_is_written_exactly_in_upper_case[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 1, "0x1abcdefabcdefabcdef", 32, "t.chw");
    test.assert_eq(status, 0);
    borrow text as &o in {
        test.assert(has(o, " @ 0x1ABCDEFABCDEFABCDEF : u32;\n"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_span_outside_the_source_is_internal_not_a_trap[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 90, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_binding.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_binding.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_register_naming_fields_that_are_not_there_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40RRW";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 0, off_e: 0, kind_s: 6, kind_e: 8, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 4 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_binding.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_binding.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_field_naming_enum_entries_that_are_not_there_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40RRWf";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_field(heap, ir, model.Field { name_s: 8, name_e: 9, lsb: 0, msb: 1, has_enum: true, enum_first: 0, enum_n: 3, cons_s: 0 - 1, cons_e: 0 });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 0, off_e: 0, kind_s: 6, kind_e: 8, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 1 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_binding.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_binding.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_an_enum_with_no_label_is_not_an_enum[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40RRWf";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_field(heap, ir, model.Field { name_s: 8, name_e: 9, lsb: 0, msb: 1, has_enum: true, enum_first: 0, enum_n: 0, cons_s: 0 - 1, cons_e: 0 });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 0, off_e: 0, kind_s: 6, kind_e: 8, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 1 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_binding.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, 0);
    borrow text as &o in {
        test.assert(has(o, "    fn r_f_get() -> u32;\n"));
        test.assert(bytes.find(buffer.bytes(o), "enum") < 0);
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_label_lists_of_different_lengths_differ_even_when_the_longer_one_starts_the_same[&h](heap: &!h Heap) -> [heap] int {
    // Mode{X,Y} then Mode{X}, with a Y after the second: without the length test the second would read that Y.
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register A @ 0x0 : RW {\n        field Mode : bits [0..1] enum { X=0, Y=1 }\n    }\n    register C @ 0x4 : RW {\n        field Mode : bits [0..1] enum { X=0 }\n        field Other : bits [2..3] enum { Y=1 }\n    }\n}\n");
    test.assert_eq(st, gen_binding.status_refused());
    borrow out as &o in {
        test.assert(has(o, "carry different label sets"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_buffer_naming_fields_that_are_not_there_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40d";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_buf(heap, ir, model.Buf { name_s: 5, name_e: 6, first: 0, n: 4 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_binding.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_binding.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_register_span_outside_the_source_is_internal_not_a_trap[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 90, off_s: 0, off_e: 0, kind_s: 5, kind_e: 6, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_binding.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_binding.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}
