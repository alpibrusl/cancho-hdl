// test_gen_c.cho -- the C header generator (src/gen_c.cho, docs/cancho-port.md 17): the header of a
// small contract written out of order, the names it cannot spell, an IR a checker would have
// refused, and a bus width the Python tool answers with a comment.
//
//     cancho test tests/unit/test_gen_c.cho <the library> --std

import std.buffer;
import std.bytes;
import std.test;
import chw.front;
import chw.gen_c;
import chw.ir as model;

fn small() -> [] &static [byte] {
    return "register-block UartCTRLx @ 0x1000, width 16, little-endian {\n    register Zed @ 0x08 : RW, reset 0x00ff {\n        field Hi : bits [8..15]\n        field Lo : bits [0..3]\n    }\n    register A @ 0x00 : RO {\n        field X : bits [0..0]\n    }\n}\n";
}

// The header (or the refusal text) of the text-form contract `text`, and its status.
fn run[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (buffer.Buffer, int) {
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, got);
        let (out, st) = gen_c.generate(heap, text, "t.chw", q);
        got = out;
        status = st;
    }
    model.drop(heap, ir);
    return (got, status);
}

fn has[&b, &n](haystack: &b buffer.Buffer, needle: &n [byte]) -> [] bool {
    return bytes.find(buffer.bytes(haystack), needle) >= 0;
}

fn test_registers_and_fields_come_out_in_offset_and_bit_order[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, small());
    test.assert_eq(st, 0);
    borrow out as &o in {
        let a = bytes.find(buffer.bytes(o), "} a_t;");
        let z = bytes.find(buffer.bytes(o), "} zed_t;");
        test.assert(a >= 0 && z > a);
        let lo = bytes.find(buffer.bytes(o), "uint16_t lo : 4;");
        let hi = bytes.find(buffer.bytes(o), "uint16_t hi : 8;");
        test.assert(lo >= 0 && hi > lo);
        test.assert(has(o, "uint16_t _rsvd4 : 4;"));
        test.assert(has(o, "uint8_t _gap1[6];"));
        test.assert(has(o, "volatile uint16_t a; /* chw:UartCTRLx.register.A */ /* RO */\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_names_are_snake_cased_by_the_rule_of_the_python_tool[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, small());
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "#ifndef CANCHO_HDL_UART_CTR_LX_H\n"));
        test.assert(has(o, "} uart_ctr_lx_t;\n"));
        test.assert(has(o, "#define UART_CTR_LX_BASE 0x00001000u\n"));
        test.assert(has(o, "#define UART_CTR_LX_ZED_RESET 0x00ffu\n"));
        test.assert(has(o, "/* Generated by cancho-hdl from t.chw. Do not edit. */\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_keyword_register_is_refused_not_written[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register INT @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, gen_c.status_refused());
    borrow out as &o in {
        test.assert(has(o, "the register name 'INT'"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_field_named_like_a_keyword_once_lower_cased_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field Static : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, gen_c.status_refused());
    borrow out as &o in {
        test.assert(has(o, "the field name 'Static'"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_dma_buffer_is_packed_with_its_gaps[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\ndma-buffer Desc {\n    field next : @0x08, owned by DEVICE\n    field head : @0x00, owned by CPU\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "typedef struct __attribute__((packed)) {\n    volatile uint32_t head; /* owner: CPU */ /* chw:B.dma.Desc.field.head */\n    uint8_t _gap4[4];\n    volatile uint32_t next; /* owner: DEVICE */ /* chw:B.dma.Desc.field.next */\n} desc_t;\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_base_address_past_2_to_the_60_is_written_exactly[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x1ffffffffffffffffff, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "#define B_BASE 0x1ffffffffffffffffffu\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

// An IR the checker would have refused: the base address is not a number. The function answers
// `internal` with a message and does not trap or write half a header.
fn test_an_ir_with_a_base_address_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "BlkRegxyz";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 3, base_s: 3, base_e: 6, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_c.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_c.status_internal());
    borrow text as &o in {
        test.assert(has(o, "base address is not a number"));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

// What the Python tool does for a width outside 8, 16, 32: a comment and the guard's end, exit 0.
fn test_a_bus_width_outside_8_16_32_is_a_comment_like_the_python_tool[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 64, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_c.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, 0);
    borrow text as &o in {
        test.assert(has(o, "/* ERROR: invalid bus_width 64; cannot generate. */\n#endif /* CANCHO_HDL_B_H */\n"));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

// A register whose field list runs past the table: unusable, not a trap.
fn test_a_register_naming_fields_that_are_not_there_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "BR0x400x00RW";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 2, base_e: 6, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 1, name_e: 2, off_s: 6, off_e: 10, kind_s: 10, kind_e: 12, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 5, n: 3 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_c.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_c.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

// One register `R` at 0x0 with one field `F` carrying one enum entry whose label is `label`, as spans of a
// source string built here.
fn with_label[&h, &l](heap: &!h Heap, label: &l [byte]) -> [heap] (buffer.Buffer, int) {
    var src = buffer.append(heap, buffer.empty(heap, 32), "B0x40R0x0RWF");
    src = buffer.append(heap, src, label);
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_entry(heap, ir, model.Entry { name_s: 12, name_e: 12 + len(label), value: 0 });
    ir = model.add_field(heap, ir, model.Field { name_s: 11, name_e: 12, lsb: 0, msb: 0, has_enum: true, enum_first: 0, enum_n: 1, cons_s: 0 - 1, cons_e: 0 });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 9, kind_e: 11, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 1 });
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow src as &sr in {
        borrow ir as &q in {
            buffer.drop(heap, got);
            let (out, st) = gen_c.generate(heap, buffer.bytes(sr), "t.chw", q);
            got = out;
            status = st;
        }
    }
    buffer.drop(heap, src);
    model.drop(heap, ir);
    return (got, status);
}

fn test_an_enum_label_that_would_end_the_comment_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = with_label(heap, "a*/b");
    test.assert_eq(st, gen_c.status_refused());
    borrow out as &o in {
        test.assert(has(o, "the enum label 'a*/b'"));
    }
    buffer.drop(heap, out);
    let (open, st2) = with_label(heap, "a/*b");
    test.assert_eq(st2, gen_c.status_refused());
    buffer.drop(heap, open);
    return 0;
}

fn test_an_enum_label_with_a_backslash_or_a_space_is_written_as_it_is[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = with_label(heap, "a\\b c");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "        /* enum: a\\b c = 0 */\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_register_offset_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40RZZZRW";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 9, kind_e: 11, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_c.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_c.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}
