// test_gen_sv.cho -- the SystemVerilog generator (src/gen_sv.cho, docs/cancho-port.md 29): the module of a small
// contract, each access kind's write line, the snake case that is this generator's own, the hex it writes, the names
// it cannot carry, and an IR a checker would have refused.
//
//     cancho test tests/unit/test_gen_sv.cho <the library> --std

import std.buffer;
import std.bytes;
import std.test;
import chw.front;
import chw.gen_sv;
import chw.ir as model;

fn has[&b, &n](haystack: &b buffer.Buffer, needle: &n [byte]) -> [] bool {
    return bytes.find(buffer.bytes(haystack), needle) >= 0;
}

fn as_int(b: bool) -> [] int {
    if b {
        return 1;
    }
    return 0;
}

// The module (or the refusal text) of the text-form contract `text`, and its status.
fn run[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (buffer.Buffer, int) {
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, got);
        let (out, st) = gen_sv.generate(heap, text, "t.chw", q);
        got = out;
        status = st;
    }
    model.drop(heap, ir);
    return (got, status);
}

// A one-register block named `block`, register `reg` of kind `kind` at `off`, width `w`, with the given reset clause.
fn block[&h, &n, &r, &k](heap: &!h Heap, name: &n [byte], reg: &r [byte], kind: &k [byte]) -> [heap] (buffer.Buffer, int) {
    var src = buffer.append(heap, buffer.empty(heap, 128), "register-block ");
    src = buffer.append(heap, src, name);
    src = buffer.append(heap, src, " @ 0x0, width 32, little-endian {\n    register ");
    src = buffer.append(heap, src, reg);
    src = buffer.append(heap, src, " @ 0x0 : ");
    src = buffer.append(heap, src, kind);
    src = buffer.append(heap, src, " {\n        field F : bits [0]\n    }\n}\n");
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow src as &sr in {
        buffer.drop(heap, got);
        let (out, st) = run(heap, buffer.bytes(sr));
        got = out;
        status = st;
    }
    buffer.drop(heap, src);
    return (got, status);
}

fn uart() -> [] &static [byte] {
    return "register-block UartRegs @ 0x4000_0000, width 32, little-endian {\n    register STATUS @ 0x04 : RO, volatile {\n        field TX : bits [0]\n    }\n    register CTRL @ 0x00 : RW, reset 0xA5 {\n        field ENABLE : bits [0]\n        field PARITY : bits [1..2] enum { None=0, evenParity=1 }\n    }\n}\n";
}

fn test_a_contract_is_written_as_the_python_tool_writes_it[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, uart());
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "// Generated by cancho-hdl from t.chw. Do not edit.\n// chw:UartRegs\n// Synthesis output is a Trust boundary (see docs/guarantees.md).\n`default_nettype none\n\nmodule uart_regs_axi #(\n    parameter ADDR_WIDTH = 32,\n   parameter DATA_WIDTH = 32\n) (\n"));
        test.assert(has(o, "    // Base address from contract: 0x40000000\n    localparam [ADDR_WIDTH-1:0] BASE_ADDR = 32'h40000000;\n"));
        test.assert(has(o, "    localparam [ADDR_WIDTH-1:0] ADDR_CTRL = 'h00000000;  // chw:UartRegs.register.CTRL\n"));
        test.assert(has(o, "    localparam [DATA_WIDTH-1:0] CTRL_PARITY_EVENPARITY = 32'd1;\n"));
        test.assert(has(o, "            r_ctrl <= 'h000000a5;  // chw:UartRegs.register.CTRL\n"));
        test.assert(has(o, "            r_status <= 'h0;  // chw:UartRegs.register.STATUS (reset undefined)\n"));
        test.assert(has(o, "    assign s_axi_bresp   = bresp_r;\n"));
        test.assert(has(o, "    input  wire                       s_axi_rready,\n\n    output wire [DATA_WIDTH-1:0]      reg_ctrl_out,  // chw:UartRegs.register.CTRL\n    output wire [DATA_WIDTH-1:0]      reg_status_out   // chw:UartRegs.register.STATUS\n);\n"));
        test.assert(has(o, "endmodule\n\n`default_nettype wire\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_registers_are_in_offset_order_everywhere[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, uart());
    test.assert_eq(st, 0);
    borrow out as &o in {
        let port_ctrl = bytes.find(buffer.bytes(o), "reg_ctrl_out,  //");
        let port_status = bytes.find(buffer.bytes(o), "reg_status_out   //");
        test.assert(port_ctrl >= 0 && port_status >= 0 && port_ctrl < port_status);
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_each_kind_has_its_write_line[&h](heap: &!h Heap) -> [heap] int {
    let cond = "            if (aw_match_b && (s_axi_awaddr == BASE_ADDR + ADDR_R) && s_axi_wvalid) r_r <= ";
    var k = 0;
    while k < 8 {
        var kind = "RO";
        var line = "            if (1'b0) r_r <= r_r;  // no-op\n";
        var other = true;
        if k == 1 {
            kind = "RW";
            line = "(r_r & ~wmask) | (s_axi_wdata & wmask);\n";
        }
        if k == 2 {
            kind = "WO";
            line = "(r_r & ~wmask) | (s_axi_wdata & wmask);\n";
        }
        if k == 3 {
            kind = "W1C";
            line = "r_r & ~(s_axi_wdata & wmask);\n";
        }
        if k == 4 {
            kind = "W0C";
            line = "r_r & (s_axi_wdata | ~wmask);\n";
        }
        if k == 5 {
            kind = "W1S";
            line = "r_r | (s_axi_wdata & wmask);\n";
        }
        if k == 6 {
            kind = "W0S";
            line = "r_r & ~(s_axi_wdata & wmask);\n";
        }
        if k == 7 {
            kind = "RC";
            line = "'h0;  // RC: read clears, write has no effect\n";
        }
        let (out, st) = block(heap, "B", "R", kind);
        test.assert_eq(st, 0);
        borrow out as &o in {
            test.assert(has(o, "            // chw:B.register.R (kind="));
            if k == 0 {
                test.assert(has(o, line));
                test.assert(has(o, "            // RO: writes are dropped and answer SLVERR. This is a Trust-tier behavioural choice; the checker flags WO/RO misuse.\n"));
                test.assert_eq(as_int(has(o, "wr_hit = 1'b1;")), 0);
                test.assert_eq(as_int(has(o, "aw_match_b && (s_axi_awaddr == BASE_ADDR + ADDR_R) && s_axi_wvalid) r_r")), 0);
            } else {
                test.assert(has(o, "        if (aw_match_b && (s_axi_awaddr == BASE_ADDR + ADDR_R)) wr_hit = 1'b1;\n"));
                var full = buffer.append(heap, buffer.empty(heap, 128), cond);
                full = buffer.append(heap, full, line);
                borrow full as &fr in {
                    test.assert(has(o, buffer.bytes(fr)));
                }
                buffer.drop(heap, full);
            }
        }
        buffer.drop(heap, out);
        k = k + 1;
    }
    return 0;
}

fn test_a_write_only_register_reads_zero_and_the_others_read_the_register[&h](heap: &!h Heap) -> [heap] int {
    let (wo, st) = block(heap, "B", "R", "WO");
    test.assert_eq(st, 0);
    borrow wo as &o in {
        test.assert(has(o, "            // WO register: reads return 0 and answer SLVERR (the spec notes this is a write-only register).\n            rdata = 'h0;\n        end\n"));
    }
    buffer.drop(heap, wo);
    let (rw, st2) = block(heap, "B", "R", "RW");
    test.assert_eq(st2, 0);
    borrow rw as &p in {
        test.assert(has(p, "            rdata = r_r;\n            rdata_valid = 1'b1;\n"));
        test.assert_eq(as_int(has(p, "WO register")), 0);
    }
    buffer.drop(heap, rw);
    return 0;
}

// This generator's own snake case: one pass, no rule for digits.
fn test_the_snake_case_is_this_generators_own[&h](heap: &!h Heap) -> [heap] int {
    let (a, st) = block(heap, "Server2Name", "TxFifoLevel", "RW");
    test.assert_eq(st, 0);
    borrow a as &o in {
        test.assert(has(o, "module server2name_axi #("));
        test.assert(has(o, "reg_tx_fifo_level_out"));
    }
    buffer.drop(heap, a);
    let (b, st2) = block(heap, "HTTPServer", "UartCTRLx", "RW");
    test.assert_eq(st2, 0);
    borrow b as &p in {
        test.assert(has(p, "module http_server_axi #("));
        test.assert(has(p, "reg_uart_ctr_lx_out"));
    }
    buffer.drop(heap, b);
    let (c, st3) = block(heap, "aBCd", "a_b", "RW");
    test.assert_eq(st3, 0);
    borrow c as &q in {
        test.assert(has(q, "module a_b_cd_axi #("));
    }
    buffer.drop(heap, c);
    return 0;
}

fn test_a_block_with_no_register_is_still_a_module[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "module b_axi #("));
        test.assert(has(o, ");\n\n    // Base address from contract: 0x00000000\n"));
        test.assert(has(o, "    input  wire                       s_axi_rready\n\n);\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_base_past_2_to_the_60_is_written_exactly_in_lower_case[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x1ABCDEFabcdefabcdef, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field F : bits [0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "0x1abcdefabcdefabcdef\n"));
        test.assert(has(o, "BASE_ADDR = 32'h1abcdefabcdefabcdef;\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_reset_is_padded_to_a_quarter_of_the_width[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 8, little-endian {\n    register R @ 0x0 : RW, reset 0x5 {\n        field F : bits [0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "r_r <= 'h05;"));
        test.assert(has(o, "BASE_ADDR = 8'h00000000;"));
    }
    buffer.drop(heap, out);
    return 0;
}

// ---- an IR built by hand: what a checked contract never reaches ----------------------------------------------------
//
// Ten pieces of text in one source: block, base, register, offset, kind, field, enum label, reset.

fn piece(k: int) -> [] &static [byte] {
    if k == 0 {
        return "B";
    }
    if k == 1 {
        return "0x40";
    }
    if k == 2 {
        return "R";
    }
    if k == 3 {
        return "0x0";
    }
    if k == 4 {
        return "RW";
    }
    if k == 5 {
        return "f";
    }
    if k == 6 {
        return "e";
    }
    return "0x7";
}

fn layout[&h, &b](heap: &!h Heap, which: int, bad: &b [byte]) -> [heap] buffer.Buffer {
    var s = buffer.empty(heap, 64);
    var k = 0;
    while k < 8 {
        if k == which {
            s = buffer.append(heap, s, bad);
        } else {
            s = buffer.append(heap, s, piece(k));
        }
        k = k + 1;
    }
    return s;
}

fn start_of(which: int, bad_len: int, k: int) -> [] int {
    var at = 0;
    var j = 0;
    while j < k {
        if j == which {
            at = at + bad_len;
        } else {
            at = at + len(piece(j));
        }
        j = j + 1;
    }
    return at;
}

fn end_of(which: int, bad_len: int, k: int) -> [] int {
    return start_of(which, bad_len, k + 1);
}

// The status and text of an IR with one register (reset included), one enum field with one label, named by the pieces.
fn full_case[&h, &b, &p](heap: &!h Heap, which: int, bad: &b [byte], width: int, path: &p [byte]) -> [heap] (buffer.Buffer, int) {
    let src = layout(heap, which, bad);
    let n = len(bad);
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: start_of(which, n, 0), name_e: end_of(which, n, 0), base_s: start_of(which, n, 1), base_e: end_of(which, n, 1), width: width, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_field(heap, ir, model.Field { name_s: start_of(which, n, 5), name_e: end_of(which, n, 5), lsb: 0, msb: 1, has_enum: true, enum_first: 0, enum_n: 1, cons_s: 0 - 1, cons_e: 0 });
    ir = model.add_entry(heap, ir, model.Entry { name_s: start_of(which, n, 6), name_e: end_of(which, n, 6), value: 0 - 3 });
    ir = model.add_reg(heap, ir, model.Reg { name_s: start_of(which, n, 2), name_e: end_of(which, n, 2), off_s: start_of(which, n, 3), off_e: end_of(which, n, 3), kind_s: start_of(which, n, 4), kind_e: end_of(which, n, 4), reset_s: start_of(which, n, 7), reset_e: end_of(which, n, 7), volatile: false, polling: false, order: 0, first: 0, n: 1 });
    var text = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow src as &sr in {
        borrow ir as &q in {
            buffer.drop(heap, text);
            let (o, s) = gen_sv.generate(heap, buffer.bytes(sr), path, q);
            text = o;
            status = s;
        }
    }
    buffer.drop(heap, src);
    model.drop(heap, ir);
    return (text, status);
}

fn test_the_layout_itself_is_a_module[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 0 - 1, "", 32, "t.chw");
    test.assert_eq(status, 0);
    borrow text as &o in {
        test.assert(has(o, "    localparam [DATA_WIDTH-1:0] R_f_E = 32'd-3;\n"));
        test.assert(has(o, "ADDR_R = 'h00000000;"));
        test.assert(has(o, "r_r <= 'h00000007;"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn refused_with[&h, &w](heap: &!h Heap, which: int, phrase: &w [byte]) -> [heap] int {
    let (text, status) = full_case(heap, which, "a\\u0041", 32, "t.chw");
    test.assert_eq(status, gen_sv.status_refused());
    borrow text as &o in {
        test.assert(has(o, phrase));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_block_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 0, "the block name");
}

fn test_a_register_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 2, "the register name");
}

fn test_a_field_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 5, "the field name");
}

fn test_an_enum_label_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 6, "the enum label");
}

fn test_a_non_ascii_source_path_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 0 - 1, "", 32, "café.chw");
    test.assert_eq(status, gen_sv.status_refused());
    borrow text as &o in {
        test.assert(has(o, "the source path"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_an_unknown_kind_writes_a_comment_quoting_it_and_no_write_logic[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 4, "XX", 32, "t.chw");
    test.assert_eq(status, 0);
    borrow text as &o in {
        test.assert(has(o, "        // Unknown kind 'XX'; no write logic emitted.\n"));
        test.assert_eq(as_int(has(o, "r_r <= ")), 1);
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_register_offset_past_2_to_the_60_is_refused_not_wrapped[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 3, "0x1000000000000000000", 32, "t.chw");
    test.assert_eq(status, gen_sv.status_refused());
    borrow text as &o in {
        test.assert(has(o, "is past 2^60"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_negative_bus_width_is_internal_not_a_size[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 0 - 1, "", 0 - 8, "t.chw");
    test.assert_eq(status, gen_sv.status_internal());
    buffer.drop(heap, text);
    return 0;
}

fn test_a_base_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 1, "nope", 32, "t.chw");
    test.assert_eq(status, gen_sv.status_internal());
    buffer.drop(heap, text);
    return 0;
}

fn test_an_offset_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 3, "zz", 32, "t.chw");
    test.assert_eq(status, gen_sv.status_internal());
    buffer.drop(heap, text);
    return 0;
}

fn test_a_reset_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 7, "zz", 32, "t.chw");
    test.assert_eq(status, gen_sv.status_internal());
    buffer.drop(heap, text);
    return 0;
}

fn test_a_span_outside_the_source_is_internal_not_a_trap[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0RW";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 90, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_sv.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_sv.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_register_naming_fields_that_are_not_there_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0RW";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 9, kind_e: 11, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 4 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_sv.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_sv.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_field_naming_enum_entries_that_are_not_there_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0RWf";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_field(heap, ir, model.Field { name_s: 11, name_e: 12, lsb: 0, msb: 1, has_enum: true, enum_first: 0, enum_n: 3, cons_s: 0 - 1, cons_e: 0 });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 9, kind_e: 11, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 1 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = gen_sv.generate(heap, src, "t.chw", q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_sv.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}
