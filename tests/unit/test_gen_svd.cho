fn test_a_register_offset_past_2_to_the_60_is_refused_not_wrapped[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x1000000000000000000";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 27, kind_s: 6, kind_e: 6, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = generate_ir(heap, src, q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_svd.status_refused());
    borrow text as &o in {
        test.assert(has(o, "is past 2^60"));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_base_past_2_to_the_60_is_written_exactly_in_upper_case[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x1abcdefabcdefabcdef, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "<baseAddress>0x1ABCDEFABCDEFABCDEF</baseAddress>"));
    }
    buffer.drop(heap, out);
    return 0;
}

