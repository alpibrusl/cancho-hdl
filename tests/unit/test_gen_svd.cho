// test_gen_svd.cho -- the CMSIS-SVD generator (src/gen_svd.cho, docs/cancho-port.md 23): the document of a small
// contract, each access mapping, the reset padding, the stable-ID comments, the refusals in the order the Python
// tool meets them, and an IR a checker would have refused.
//
//     cancho test tests/unit/test_gen_svd.cho <the library> --std

import std.buffer;
import std.bytes;
import std.test;
import chw.front;
import chw.gen_svd;
import chw.ir as model;

// The document (or the refusal text) of the text-form contract `text`, and its status.
fn run[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (buffer.Buffer, int) {
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, got);
        let (out, st) = gen_svd.generate(heap, text, "t.chw", q);
        got = out;
        status = st;
    }
    model.drop(heap, ir);
    return (got, status);
}

fn has[&b, &n](haystack: &b buffer.Buffer, needle: &n [byte]) -> [] bool {
    return bytes.find(buffer.bytes(haystack), needle) >= 0;
}

// A one-register block as an IR built by hand: block `B` at `0x40`, register `R` at `0x0`. `src` must hold
// "B0x40R0x0" at its start.
fn one_register[&h](heap: &!h Heap, width: int) -> [heap] model.Ir {
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: width, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    return model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 6, kind_e: 6, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
}

fn generate_ir[&h, &s, &q](heap: &!h Heap, src: &s [byte], ir: &q model.Ir) -> [heap] (buffer.Buffer, int) {
    return gen_svd.generate(heap, src, "t.chw", ir);
}

fn test_a_block_with_fields_an_enum_and_an_interrupt_is_written_as_the_python_tool_writes_it[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block Blk @ 0x4000_0000, width 32, little-endian {\n    register CTRL @ 0x0 : RW, reset 0x1 {\n        field EN : bits [0..0]\n        field MODE : bits [1..2] enum { A=0, B=1 }\n    }\n    interrupt done from CTRL.EN {\n        number 5\n        source @ CTRL.EN\n    }\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!-- Generated by cancho-hdl from t.chw. Do not edit. -->\n"));
        test.assert(has(o, "      <baseAddress>0x40000000</baseAddress>\n"));
        test.assert(has(o, "          <name>CTRL</name>  <!-- chw:Blk.register.CTRL -->\n"));
        test.assert(has(o, "          <resetValue>0x00000001</resetValue>\n"));
        test.assert(has(o, "            <lsb>1</lsb><msb>2</msb>\n"));
        test.assert(has(o, "                <value>1</value>\n"));
        test.assert(has(o, "      <!-- chw:Blk.interrupt.done, IRQ 5 -->\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_each_access_kind_has_its_cmsis_mapping[&h](heap: &!h Heap) -> [heap] int {
    let head = "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : ";
    let tail = " {\n        field A : bits [0..0]\n    }\n}\n";
    var k = 0;
    while k < 8 {
        var kind = "RO";
        var wanted = "<access>read-only</access>\n";
        var extra = "";
        if k == 1 {
            kind = "WO";
            wanted = "<access>write-only</access>\n";
        }
        if k == 2 {
            kind = "RW";
            wanted = "<access>read-write</access>\n";
        }
        if k == 3 {
            kind = "RC";
            extra = "<readAction>clear</readAction>";
        }
        if k == 4 {
            kind = "W0C";
            extra = "<modifiedWriteValues>zeroToClear</modifiedWriteValues>";
        }
        if k == 5 {
            kind = "W0S";
            extra = "<modifiedWriteValues>zeroToSet</modifiedWriteValues>";
        }
        if k == 6 {
            kind = "W1C";
            extra = "<modifiedWriteValues>oneToClear</modifiedWriteValues>";
        }
        if k == 7 {
            kind = "W1S";
            extra = "<modifiedWriteValues>oneToSet</modifiedWriteValues>";
        }
        var src = buffer.append(heap, buffer.empty(heap, 128), head);
        src = buffer.append(heap, src, kind);
        src = buffer.append(heap, src, tail);
        borrow src as &sr in {
            let (out, st) = run(heap, buffer.bytes(sr));
            test.assert_eq(st, 0);
            borrow out as &o in {
                if len(extra) > 0 {
                    test.assert(has(o, extra));
                    test.assert(has(o, "<access>read-write</access>\n"));
                } else {
                    test.assert(has(o, wanted));
                    test.assert(bytes.find(buffer.bytes(o), "modifiedWriteValues") < 0);
                    test.assert(bytes.find(buffer.bytes(o), "readAction") < 0);
                }
            }
            buffer.drop(heap, out);
        }
        buffer.drop(heap, src);
        k = k + 1;
    }
    return 0;
}

fn test_a_register_without_a_reset_says_so_and_emits_zero[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 16, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "          <!-- reset undefined in the contract; emitting 0x0 per §6.2 -->\n          <resetValue>0x0</resetValue>\n"));
        test.assert(has(o, "  <width>16</width>\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_reset_is_padded_to_the_bus_width_and_an_offset_is_not[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 8, little-endian {\n    register R @ 0xa : RW, reset 0x5 {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "<resetValue>0x05</resetValue>"));
        test.assert(has(o, "<addressOffset>0xA</addressOffset>"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_registers_are_written_in_offset_order_and_equal_offsets_keep_their_order[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register Z @ 0x8 : RW {\n        field A : bits [0..0]\n    }\n    register Y @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        let y = bytes.find(buffer.bytes(o), "<name>Y</name>");
        let z = bytes.find(buffer.bytes(o), "<name>Z</name>");
        test.assert(y >= 0 && z >= 0 && y < z);
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_block_with_no_register_is_refused_with_the_python_tools_words[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n}\n");
    test.assert_eq(st, gen_svd.status_refused());
    borrow out as &o in {
        test.assert(has(o, "SVD peripheral with zero registers: <registers> requires at least one register; declare at least one"));
    }
    buffer.drop(heap, out);
    return 0;
}

// Text in an XML comment cannot hold `--`: the block name, an interrupt and a register each refuse, quoting what the Python tool quotes.
fn test_a_double_dash_in_a_name_is_refused_quoting_the_joined_stable_id_for_an_interrupt[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0i--";
    var ir = one_register(heap, 32);
    ir = model.add_intr(heap, ir, model.Intr { name_s: 9, name_e: 12, number: 3, source: model.no_ref(), enable: model.no_ref(), status: model.no_ref(), clear: model.no_ref(), clear_kind_s: 0 - 1, clear_kind_e: 0, order: 0 });
    var text = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = generate_ir(heap, src, q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_svd.status_refused());
    borrow text as &o in {
        test.assert(has(o, "stable-ID component 'chw:B.interrupt.i--' contains '--', which a legal XML comment cannot carry; refusing, not substituting"));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_double_dash_in_the_block_name_comes_before_the_zero_register_refusal[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n}\n");
    buffer.drop(heap, out);
    test.assert_eq(st, gen_svd.status_refused());
    let src = "a--b0x40";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 4, base_s: 4, base_e: 8, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    var text = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = generate_ir(heap, src, q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_svd.status_refused());
    borrow text as &t in {
        test.assert(has(t, "stable-ID component 'a--b' contains"));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_source_path_with_markup_or_a_double_dash_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let text = "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n";
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    borrow ir as &q in {
        let (a, sa) = gen_svd.generate(heap, text, "a&b.chw", q);
        test.assert_eq(sa, gen_svd.status_refused());
        borrow a as &ar in {
            test.assert(has(ar, "the source path 'a&b.chw'"));
        }
        buffer.drop(heap, a);
        let (b, sb) = gen_svd.generate(heap, text, "a<b.chw", q);
        test.assert_eq(sb, gen_svd.status_refused());
        buffer.drop(heap, b);
        let (c, sc) = gen_svd.generate(heap, text, "a--b.chw", q);
        test.assert_eq(sc, gen_svd.status_refused());
        borrow c as &cr in {
            test.assert(has(cr, "stable-ID component 'a--b.chw' contains"));
        }
        buffer.drop(heap, c);
        let (d, sd) = gen_svd.generate(heap, text, "a>b.chw", q);
        test.assert_eq(sd, 0);
        buffer.drop(heap, d);
    }
    model.drop(heap, ir);
    return 0;
}

fn test_markup_in_a_name_is_escaped_in_text_and_left_alone_in_comments[&h](heap: &!h Heap) -> [heap] int {
    let src = "A&B0x40R0x0";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 3, base_s: 3, base_e: 7, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 7, name_e: 8, off_s: 8, off_e: 11, kind_s: 8, kind_e: 8, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = generate_ir(heap, src, q);
        text = o;
        test.assert_eq(s, gen_svd.status_refused());
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "<name>B</name>"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_name_with_an_escape_or_a_non_ascii_byte_is_refused_not_written[&h](heap: &!h Heap) -> [heap] int {
    let src = "B\\u0041x40R0x0";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 7, base_s: 7, base_e: 11, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 11, name_e: 12, off_s: 12, off_e: 15, kind_s: 12, kind_e: 12, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var text = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = generate_ir(heap, src, q);
        text = o;
        status = s;
    }
    test.assert(status != 0);
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_an_interrupt_without_a_number_is_internal_after_the_earlier_refusals[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0ii";
    var ir = one_register(heap, 32);
    ir = model.add_intr(heap, ir, model.Intr { name_s: 9, name_e: 10, number: 0 - 1, source: model.no_ref(), enable: model.no_ref(), status: model.no_ref(), clear: model.no_ref(), clear_kind_s: 0 - 1, clear_kind_e: 0, order: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = generate_ir(heap, src, q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_svd.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

