}

// An IR left by a parse that failed, or built by hand, may name text that is not there: internal, never a slice that traps.
fn test_a_span_outside_the_source_is_internal_not_a_trap[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 90, kind_s: 6, kind_e: 6, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = generate_ir(heap, src, q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_svd.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

// ---- names the document cannot carry, and an IR a checker would have refused ---------------------------------------
//
// The contract of the layout below: ten pieces of text in one source, in this order, each a span of the IR.

fn piece(k: int) -> [] &static [byte] {
    if k == 0 {
        return "B";
    }
    if k == 1 {
        return "0x40";
    }
    if k == 2 {
        return "R";
    }
    if k == 3 {
        return "0x0";
    }
    if k == 4 {
        return "RW";
    }
    if k == 5 {
        return "1";
    }
    if k == 6 {
        return "i";
    }
    if k == 7 {
        return "d";
    }
    if k == 8 {
        return "f";
    }
    return "e";
}

// The source with piece `which` replaced by `bad`.
fn layout[&h, &b](heap: &!h Heap, which: int, bad: &b [byte]) -> [heap] buffer.Buffer {
    var s = buffer.empty(heap, 64);
    var k = 0;
    while k < 10 {
        if k == which {
            s = buffer.append(heap, s, bad);
        } else {
            s = buffer.append(heap, s, piece(k));
        }
        k = k + 1;
    }
    return s;
}

// Where piece `k` starts in `layout(which, bad)`.
fn start_of(which: int, bad_len: int, k: int) -> [] int {
    var at = 0;
    var j = 0;
    while j < k {
        if j == which {
            at = at + bad_len;
        } else {
            at = at + len(piece(j));
        }
        j = j + 1;
    }
    return at;
}

fn end_of(which: int, bad_len: int, k: int) -> [] int {
    return start_of(which, bad_len, k + 1);
}

// The status and text of the IR over `layout(which, bad)`, with one register, one field with one enum entry, one
// interrupt and one DMA buffer, named by the pieces.
fn full_case[&h, &b](heap: &!h Heap, which: int, bad: &b [byte]) -> [heap] (buffer.Buffer, int) {
    let src = layout(heap, which, bad);
    let n = len(bad);
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: start_of(which, n, 0), name_e: end_of(which, n, 0), base_s: start_of(which, n, 1), base_e: end_of(which, n, 1), width: 32, big: false, ver_s: start_of(which, n, 5), ver_e: end_of(which, n, 5), sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_field(heap, ir, model.Field { name_s: start_of(which, n, 8), name_e: end_of(which, n, 8), lsb: 0, msb: 0, has_enum: true, enum_first: 0, enum_n: 1, cons_s: 0 - 1, cons_e: 0 });
    ir = model.add_entry(heap, ir, model.Entry { name_s: start_of(which, n, 9), name_e: end_of(which, n, 9), value: 1 });
    ir = model.add_reg(heap, ir, model.Reg { name_s: start_of(which, n, 2), name_e: end_of(which, n, 2), off_s: start_of(which, n, 3), off_e: end_of(which, n, 3), kind_s: start_of(which, n, 4), kind_e: end_of(which, n, 4), reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 1 });
    ir = model.add_intr(heap, ir, model.Intr { name_s: start_of(which, n, 6), name_e: end_of(which, n, 6), number: 3, source: model.no_ref(), enable: model.no_ref(), status: model.no_ref(), clear: model.no_ref(), clear_kind_s: 0 - 1, clear_kind_e: 0, order: 0 });
    ir = model.add_buf(heap, ir, model.Buf { name_s: start_of(which, n, 7), name_e: end_of(which, n, 7), first: 0, n: 0 });
    var text = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow src as &sr in {
        borrow ir as &q in {
            buffer.drop(heap, text);
            let (o, s) = generate_ir(heap, buffer.bytes(sr), q);
            text = o;
            status = s;
        }
    }
    buffer.drop(heap, src);
    model.drop(heap, ir);
    return (text, status);
}

fn refused_with[&h, &w](heap: &!h Heap, which: int, phrase: &w [byte]) -> [heap] int {
    let (text, status) = full_case(heap, which, "a\\u0041");
    test.assert_eq(status, gen_svd.status_refused());
    borrow text as &o in {
        test.assert(has(o, phrase));
    }
    buffer.drop(heap, text);
    let (ok, st) = full_case(heap, which, piece(which));
    test.assert_eq(st, 0);
    buffer.drop(heap, ok);
    return 0;
}

fn test_the_layout_itself_is_a_document[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 0 - 1, "");
    test.assert_eq(status, 0);
    borrow text as &o in {
        test.assert(has(o, "<name>R</name>"));
        test.assert(has(o, "<name>f</name>"));
        test.assert(has(o, "<name>e</name>"));
        test.assert(has(o, "chw:B.interrupt.i, IRQ 3"));
        test.assert(has(o, "chw:B.dma.d"));
        test.assert(has(o, "<version>1</version>"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_block_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 0, "the block name");
}

fn test_a_version_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 5, "the schema version");
}

fn test_an_interrupt_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 6, "the interrupt name");
}

fn test_a_dma_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 7, "the DMA buffer name");
}

fn test_a_register_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 2, "the register name");
}

fn test_a_field_name_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 8, "the field name");
}

fn test_an_enum_label_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    return refused_with(heap, 9, "the enum label");
}

fn test_a_non_ascii_byte_in_a_name_is_refused_like_an_escape[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 2, "café");
    test.assert_eq(status, gen_svd.status_refused());
    buffer.drop(heap, text);
    return 0;
}

fn test_a_non_ascii_source_path_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let text = "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n";
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    borrow ir as &q in {
        let (a, sa) = gen_svd.generate(heap, text, "café.chw", q);
        test.assert_eq(sa, gen_svd.status_refused());
        borrow a as &ar in {
            test.assert(has(ar, "the source path"));
        }
        buffer.drop(heap, a);
    }
    model.drop(heap, ir);
    return 0;
}

fn test_an_access_kind_with_no_mapping_is_refused_with_the_python_tools_words[&h](heap: &!h Heap) -> [heap] int {
    let (text, status) = full_case(heap, 4, "XX");
    test.assert_eq(status, gen_svd.status_refused());
    borrow text as &o in {
        test.assert(has(o, "access kind 'XX' has no CMSIS-SVD mapping"));
    }
    buffer.drop(heap, text);
    return 0;
}

fn test_a_reset_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0zz";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 6, kind_e: 6, reset_s: 9, reset_e: 11, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (o, s) = generate_ir(heap, src, q);
        text = o;
        status = s;
    }
    test.assert_eq(status, gen_svd.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

