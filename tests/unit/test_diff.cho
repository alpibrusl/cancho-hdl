}

fn test_hex_numbers_compare_by_value_in_either_case() -> [] int {
    var s = 0;
    s = s + test.assert(du.hex_equal("0x0A", "0x0a"));
    s = s + test.assert(du.hex_equal("0x00", "0x0"));
    s = s + test.assert(du.hex_equal("0x0000FF", "0xff"));
    s = s + test.assert(du.hex_equal("0x0F", "0x0f"));
    s = s + test.assert(!du.hex_equal("0x0F", "0x0e"));
    s = s + test.assert(!du.hex_equal("0x10", "0x1"));
    s = s + test.assert(!du.hex_equal("0x1", "0x2"));
    s = s + test.assert(du.hex_equal("0x00000000000000000000000000000001", "0x1"));
    return s;
}

fn plain[&h, &x](heap: &!h Heap, doc: &x [byte]) -> [heap] bool {
    let tape = box_slice(heap, json.tape_len(doc), 0);
    var nodes = 0;
    borrow mut tape as &!w in {
        nodes = json.parse(doc, contents(w));
    }
    var ok = false;
    borrow tape as &t in {
        ok = du.plain_json(doc, contents(t), nodes);
    }
    unbox_slice(heap, tape);
    return ok;
}

fn test_a_file_is_copied_only_if_its_strings_and_numbers_are_in_the_form_json_dumps_writes[&h](heap: &!h Heap) -> [heap] int {
    var s = 0;
    s = s + test.assert(plain(heap, "{\"a\": [1, -2, 30, \"x y\"]}"));
    s = s + test.assert(!plain(heap, "{\"a\": \"\\u0041\"}"));
    s = s + test.assert(!plain(heap, "{\"a\": \"\\n\"}"));
    s = s + test.assert(!plain(heap, "{\"a\": \"é\"}"));
    s = s + test.assert(!plain(heap, "{\"a\": 1.5}"));
    s = s + test.assert(!plain(heap, "{\"a\": 1e2}"));
    s = s + test.assert(!plain(heap, "{\"a\": -0}"));
    s = s + test.assert(!plain(heap, "{\"\\u0041\": 1}"));
    return s;
}

fn pretty_of[&h, &x](heap: &!h Heap, doc: &x [byte]) -> [heap] buffer.Buffer {
    let tape = box_slice(heap, json.tape_len(doc), 0);
    borrow mut tape as &!w in {
        json.parse(doc, contents(w));
    }
    var out = buffer.empty(heap, 16);
    borrow tape as &t in {
        buffer.drop(heap, out);
        out = diff_fmt.pretty(heap, buffer.empty(heap, 64), doc, contents(t), 0, 0);
    }
    unbox_slice(heap, tape);
    return out;
}

// json.dumps(x, indent=2) of {"a": [], "b": [1, {"c": "d"}], "e": {}, "f": null, "g": [true, false]}.
fn test_indent_two_puts_an_element_a_line_and_leaves_empty_containers_closed[&h](heap: &!h Heap) -> [heap] int {
    let out = pretty_of(heap, "{\"a\": [], \"b\": [1, {\"c\": \"d\"}], \"e\": {}, \"f\": null, \"g\": [true, false]}");
    var same = false;
    borrow out as &or in {
        same = bytes.equal(buffer.bytes(or), "{\n  \"a\": [],\n  \"b\": [\n    1,\n    {\n      \"c\": \"d\"\n    }\n  ],\n  \"e\": {},\n  \"f\": null,\n  \"g\": [\n    true,\n    false\n  ]\n}");
    }
    buffer.drop(heap, out);
    return test.assert(same);
}

fn reason_of[&h, &x](heap: &!h Heap, doc: &x [byte]) -> [heap] buffer.Buffer {
    let tape = box_slice(heap, json.tape_len(doc), 0);
    borrow mut tape as &!w in {
        json.parse(doc, contents(w));
    }
    var out = buffer.empty(heap, 16);
    borrow tape as &t in {
        buffer.drop(heap, out);
        out = impact.reason(heap, doc, contents(t));
    }
    unbox_slice(heap, tape);
    return out;
}

fn expect_reason[&h, &x](heap: &!h Heap, doc: &x [byte], want: &static [byte]) -> [heap] int {
    let out = reason_of(heap, doc);
    var same = false;
    borrow out as &or in {
        same = bytes.equal(buffer.bytes(or), want);
    }
    buffer.drop(heap, out);
    return test.assert(same);
}

// `_short_reason`: the block line first, then each non-empty list as `name=count` in the fixed order, joined by "; ".
fn test_the_reason_of_a_stale_artifact_counts_the_lists_that_changed[&h](heap: &!h Heap) -> [heap] int {
    var s = 0;
    s = s + expect_reason(heap, "{\"added_registers\": [1, 2], \"changed_dma_layouts\": [1], \"changed_block_properties\": [1]}", "block properties changed; added_registers=2; changed_dma_layouts=1");
    s = s + expect_reason(heap, "{\"widened_fields\": [1], \"changed_reset_values\": [1, 2, 3], \"moved_registers\": [1]}", "moved_registers=1; widened_fields=1; changed_reset_values=3");
    s = s + expect_reason(heap, "{\"added_registers\": []}", "");
    return s;
}

fn eq[&h, &x, &y](heap: &!h Heap, a: &x [byte], b: &y [byte]) -> [heap] bool {
    let ta = box_slice(heap, json.tape_len(a), 0);
    let tb = box_slice(heap, json.tape_len(b), 0);
    borrow mut ta as &!aw in {
        json.parse(a, contents(aw));
    }
    borrow mut tb as &!bw in {
        json.parse(b, contents(bw));
    }
    var same = false;
    borrow ta as &ar in {
        borrow tb as &br in {
            same = du.equal(a, contents(ar), 0, b, contents(br), 0);
        }
    }
    unbox_slice(heap, ta);
    unbox_slice(heap, tb);
    return same;
}

// Python's `==` on two JSON values: an object as a dict (any key order, a repeated key keeping its last value), a list
// element by element, True is not False, 1 is not "1".
fn test_two_json_values_are_equal_as_python_compares_them[&h](heap: &!h Heap) -> [heap] int {
    var s = 0;
    s = s + test.assert(eq(heap, "[1, 2]", "[1, 2]"));
    s = s + test.assert(!eq(heap, "[1, 2]", "[1, 2, 3]"));
    s = s + test.assert(!eq(heap, "[1, 2, 3]", "[1, 2]"));
    s = s + test.assert(!eq(heap, "[1, 2]", "[1, 3]"));
    s = s + test.assert(eq(heap, "[1, [2, {\"a\": 3}]]", "[1, [2, {\"a\": 3}]]"));
    s = s + test.assert(!eq(heap, "[1, [2, {\"a\": 3}]]", "[1, [2, {\"a\": 4}]]"));
    s = s + test.assert(eq(heap, "{\"a\": 1, \"b\": 2}", "{\"b\": 2, \"a\": 1}"));
    s = s + test.assert(!eq(heap, "{\"a\": 1, \"b\": 2}", "{\"a\": 1}"));
    s = s + test.assert(!eq(heap, "{\"a\": 1}", "{\"a\": 1, \"b\": 2}"));
    s = s + test.assert(!eq(heap, "{\"a\": 1}", "{\"b\": 1}"));
    s = s + test.assert(!eq(heap, "{\"a\": 1}", "{\"a\": 2}"));
    s = s + test.assert(eq(heap, "{\"a\": 1, \"a\": 2}", "{\"a\": 2}"));
    s = s + test.assert(!eq(heap, "{\"a\": 1, \"a\": 2}", "{\"a\": 1}"));
    s = s + test.assert(!eq(heap, "{\"a\": 1, \"b\": 1}", "{\"a\": 1, \"a\": 1}"));
    s = s + test.assert(!eq(heap, "true", "false"));
    s = s + test.assert(eq(heap, "true", "true"));
    s = s + test.assert(!eq(heap, "1", "\"1\""));
    s = s + test.assert(!eq(heap, "\"\"", "0"));
    s = s + test.assert(!eq(heap, "null", "0"));
    s = s + test.assert(eq(heap, "\"abc\"", "\"abc\""));
    s = s + test.assert(!eq(heap, "\"abc\"", "\"abd\""));
    return s;
}

fn value_of[&h, &x](heap: &!h Heap, doc: &x [byte]) -> [heap] buffer.Buffer {
    let tape = box_slice(heap, json.tape_len(doc), 0);
    borrow mut tape as &!w in {
        json.parse(doc, contents(w));
    }
    var out = buffer.empty(heap, 16);
    borrow tape as &t in {
        buffer.drop(heap, out);
        out = du.value(heap, buffer.empty(heap, 64), doc, contents(t), 0);
    }
    unbox_slice(heap, tape);
    return out;
}

// json.dumps writes `, ` and `: ` and walks a container's children whatever they hold.
fn test_a_nested_value_is_written_as_json_dumps_writes_it[&h](heap: &!h Heap) -> [heap] int {
    let out = value_of(heap, "{\"a\":[1,{\"b\":2},[]],\"c\":{\"d\":{\"e\":3}},\"f\":null,\"g\":true}");
    var same = false;
    borrow out as &or in {
        same = bytes.equal(buffer.bytes(or), "{\"a\": [1, {\"b\": 2}, []], \"c\": {\"d\": {\"e\": 3}}, \"f\": null, \"g\": true}");
    }
    buffer.drop(heap, out);
    return test.assert(same);
}

// A repeated key of an enum is one label with the last value (Python's dict): the first position, the last value.
fn test_a_repeated_enum_label_is_one_label_with_its_last_value[&h](heap: &!h Heap) -> [heap] int {
    let twice = "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x0\",\"kind\":\"RW\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":1,\"enum\":{\"A\":0,\"B\":1,\"A\":5}}]}]}}";
    let once = "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x0\",\"kind\":\"RW\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":1,\"enum\":{\"A\":5,\"B\":1}}]}]}}";
    var s = 0;
    s = s + test.assert(has(heap, twice, once, "\"changed_enum_values\": []"));
    s = s + test.assert(has(heap, once, twice, "\"changed_enum_values\": []"));
    return s;
}

fn test_a_changed_lsb_alone_is_a_change_of_the_bit_range[&h](heap: &!h Heap) -> [heap] int {
    var s = 0;
    s = s + test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":1,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"narrowed_fields\": [{\"id\": \"chw:B.register.R.field.F\", \"from\": {\"lsb\": 0, \"msb\": 3}, \"to\": {\"lsb\": 1, \"msb\": 3}}]"));
    s = s + test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":1,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"widened_fields\": []"));
    s = s + test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":1,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"repositioned_fields\": []"));
    return s;
}

fn test_a_coherence_flag_changed_from_true_to_false_and_to_absent_is_a_change[&h](heap: &!h Heap) -> [heap] int {
    var s = 0;
    s = s + test.assert(has(heap, "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\",\"coherent\":true},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\",\"coherent\":false},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"coherence_changes\": [{\"id\": \"chw:B.dma.D.field.X\", \"from\": true, \"to\": false}]"));
    s = s + test.assert(has(heap, "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\",\"coherent\":true},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", base(), "\"coherence_changes\": [{\"id\": \"chw:B.dma.D.field.X\", \"from\": true, \"to\": null}]"));
    return s;
}

fn test_a_dma_field_added_alone_changes_the_layout[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"},{\"name\":\"W\",\"offset\":\"0x10\",\"owner\":\"CPU\"}]}]}", "\"changed_dma_layouts\": [{\"id\": \"chw:B.dma.D\", \"added_field_ids\": [\"chw:B.dma.D.field.W\"], \"removed_field_ids\": [], \"moved_fields\": []}]"));
}

fn test_a_dma_field_removed_alone_changes_the_layout[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"}]}]}", "\"changed_dma_layouts\": [{\"id\": \"chw:B.dma.D\", \"added_field_ids\": [], \"removed_field_ids\": [\"chw:B.dma.D.field.Y\"], \"moved_fields\": []}]"));
}
