// test_diff.cho -- `chw diff` and `chw impact` (src/diff*.cho, src/impact.cho), one change at a time.
//
// A base contract and a candidate with ONE change are run through `diff.document`, and the lists the change should
// have made are looked for in the text, byte for byte. Every expected string was taken from `compute_diff` of
// oracle/legacy/tools/diff/diff.py on the same two contracts (docs/cancho-port.md, 33.5); the changes are named by the test.
//
//     cancho test tests/unit/test_diff.cho src/*.cho --std
//     (all of src/ except main.cho and conform.cho)

import std.buffer;
import std.bytes;
import std.json;
import std.test;
import chw.diff;
import chw.diff_fmt;
import chw.diff_util as du;
import chw.impact;

// The base contract of every test: two registers (one with a reset, two fields, an enum), an interrupt with a source
// and a clear, a DMA buffer of two fields.
fn base() -> [] &static [byte] {
    return "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}";
}

// The text of `diff.document` for two contracts in the JSON wire form.
fn document[&h, &b, &c](heap: &!h Heap, base: &b [byte], cand: &c [byte]) -> [heap] buffer.Buffer {
    let bt = box_slice(heap, json.tape_len(base), 0);
    let ct = box_slice(heap, json.tape_len(cand), 0);
    borrow mut bt as &!bw in {
        json.parse(base, contents(bw));
    }
    borrow mut ct as &!cw in {
        json.parse(cand, contents(cw));
    }
    var out = buffer.empty(heap, 16);
    borrow bt as &br in {
        borrow ct as &cr in {
            buffer.drop(heap, out);
            out = diff.document(heap, buffer.empty(heap, 1024), base, contents(br), cand, contents(cr));
        }
    }
    unbox_slice(heap, bt);
    unbox_slice(heap, ct);
    return out;
}

// Does the diff of `base` and `cand` contain `fragment`?
fn has[&h, &b, &c](heap: &!h Heap, base: &b [byte], cand: &c [byte], fragment: &static [byte]) -> [heap] bool {
    let out = document(heap, base, cand);
    var found = false;
    borrow out as &or in {
        found = bytes.find(buffer.bytes(or), fragment) >= 0;
    }
    buffer.drop(heap, out);
    return found;
}

// Is the diff of `base` and `cand` exactly `whole`?
fn is[&h, &b, &c](heap: &!h Heap, base: &b [byte], cand: &c [byte], whole: &static [byte]) -> [heap] bool {
    let out = document(heap, base, cand);
    var same = false;
    borrow out as &or in {
        same = bytes.equal(buffer.bytes(or), whole);
    }
    buffer.drop(heap, out);
    return same;
}

fn test_identical[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(is(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "{\"schema\": \"cancho-hdl-diff\", \"version\": \"0.1.0\", \"base_id\": \"chw:B.register\", \"candidate_id\": \"chw:B.register\", \"added_registers\": [], \"removed_registers\": [], \"moved_registers\": [], \"widened_fields\": [], \"narrowed_fields\": [], \"repositioned_fields\": [], \"added_fields\": [], \"removed_fields\": [], \"changed_enum_values\": [], \"changed_interrupts\": [], \"added_interrupts\": [], \"removed_interrupts\": [], \"changed_dma_layouts\": [], \"changed_reset_values\": [], \"changed_block_properties\": []}"));
}

fn test_a_field_widened[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":5,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"widened_fields\": [{\"id\": \"chw:B.register.R.field.F\", \"from\": {\"lsb\": 0, \"msb\": 3}, \"to\": {\"lsb\": 0, \"msb\": 5}}]"));
}

fn test_a_field_narrowed[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":1,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"narrowed_fields\": [{\"id\": \"chw:B.register.R.field.F\", \"from\": {\"lsb\": 0, \"msb\": 3}, \"to\": {\"lsb\": 0, \"msb\": 1}}]"));
}

fn test_a_field_repositioned[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":4,\"msb\":7,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"repositioned_fields\": [{\"id\": \"chw:B.register.R.field.F\", \"from\": {\"lsb\": 0, \"msb\": 3}, \"to\": {\"lsb\": 4, \"msb\": 7}}]"));
}

fn test_a_field_neither_contained_nor_containing_is_repositioned[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":2,\"msb\":5,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"repositioned_fields\": [{\"id\": \"chw:B.register.R.field.F\", \"from\": {\"lsb\": 0, \"msb\": 3}, \"to\": {\"lsb\": 2, \"msb\": 5}}]") && has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":2,\"msb\":5,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"widened_fields\": []") && has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":2,\"msb\":5,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"narrowed_fields\": []"));
}

fn test_a_register_added[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"},{\"name\":\"T\",\"offset\":\"0x08\",\"kind\":\"WO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"added_registers\": [{\"id\": \"chw:B.register.T\", \"offset\": \"0x08\", \"kind\": \"WO\"}]"));
}

fn test_a_register_removed[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"removed_registers\": [{\"id\": \"chw:B.register.S\", \"offset\": \"0x04\", \"kind\": \"RO\"}]"));
}

fn test_a_register_moved_and_the_same_offset_in_another_spelling_is_not_a_move[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x08\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"moved_registers\": [{\"id\": \"chw:B.register.R\", \"from_offset\": \"0x00\", \"to_offset\": \"0x08\"}]"));
}

fn test_an_offset_spelled_in_another_case_or_with_leading_zeros_is_the_same[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x0000\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"moved_registers\": []"));
}

fn test_reset_removed_then_added[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"changed_reset_values\": [{\"id\": \"chw:B.register.R\", \"from\": \"0x0\", \"to\": null}]"));
}

fn test_reset_added[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\",\"reset\":\"0x1\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"changed_reset_values\": [{\"id\": \"chw:B.register.S\", \"from\": null, \"to\": \"0x1\"}]"));
}

fn test_reset_changed[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x1F\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"changed_reset_values\": [{\"id\": \"chw:B.register.R\", \"from\": \"0x0\", \"to\": \"0x1F\"}]"));
}

fn test_reset_spelled_differently_is_the_same[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x00\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"changed_reset_values\": []"));
}

fn test_a_field_added[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\",\"fields\":[{\"name\":\"Z\",\"lsb\":0,\"msb\":0}]}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"added_fields\": [{\"id\": \"chw:B.register.S.field.Z\", \"lsb\": 0, \"msb\": 0}]"));
}

fn test_a_field_removed[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"removed_fields\": [{\"id\": \"chw:B.register.R.field.G\", \"lsb\": 8, \"msb\": 9}]"));
}

fn test_enum_labels_changed_dropped_and_added[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":7,\"C\":2}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "\"changed_enum_values\": [{\"id\": \"chw:B.register.R.field.F\", \"label\": \"A\", \"from\": 0, \"to\": 7}, {\"id\": \"chw:B.register.R.field.F\", \"label\": \"C\", \"from\": null, \"to\": 2}, {\"id\": \"chw:B.register.R.field.F\", \"label\": \"B\", \"from\": 1, \"to\": null}]"));
}

fn test_an_enum_added_to_a_field_that_had_none[&h](heap: &!h Heap) -> [heap] int {
