fn test_the_block_renamed_everything_is_added_and_removed[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(is(heap, base(), "{\"version\":\"0.1.0\",\"block\":{\"name\":\"C\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", "{\"schema\": \"cancho-hdl-diff\", \"version\": \"0.1.0\", \"base_id\": \"chw:B.register\", \"candidate_id\": \"chw:C.register\", \"added_registers\": [{\"id\": \"chw:C.register.R\", \"offset\": \"0x00\", \"kind\": \"RW\"}, {\"id\": \"chw:C.register.S\", \"offset\": \"0x04\", \"kind\": \"RO\"}], \"removed_registers\": [{\"id\": \"chw:B.register.R\", \"offset\": \"0x00\", \"kind\": \"RW\"}, {\"id\": \"chw:B.register.S\", \"offset\": \"0x04\", \"kind\": \"RO\"}], \"moved_registers\": [], \"widened_fields\": [], \"narrowed_fields\": [], \"repositioned_fields\": [], \"added_fields\": [], \"removed_fields\": [], \"changed_enum_values\": [], \"changed_interrupts\": [], \"added_interrupts\": [{\"id\": \"chw:C.interrupt.I\"}], \"removed_interrupts\": [{\"id\": \"chw:B.interrupt.I\"}], \"changed_dma_layouts\": [{\"id\": \"chw:C.dma.D\", \"added_field_ids\": [\"chw:C.dma.D.field.X\", \"chw:C.dma.D.field.Y\"], \"removed_field_ids\": [], \"moved_fields\": [], \"owner_changes\": []}, {\"id\": \"chw:B.dma.D\", \"added_field_ids\": [], \"removed_field_ids\": [\"chw:B.dma.D.field.X\", \"chw:B.dma.D.field.Y\"], \"moved_fields\": []}], \"changed_reset_values\": [], \"changed_block_properties\": [{\"property\": \"name\", \"from\": \"B\", \"to\": \"C\"}]}"));
}

