    return same(heap, "register-block P @ 0x2000, width 32, little-endian {\n    register CTRL @ 0x00 RW {\n    }\n}\n", 1, "[{\"target\": \"c-header\", \"input\": \"c.chw\", \"tool\": \"clang (Ubuntu clang version 18.1.3 (1ubuntu1))\", \"outcome\": \"passed\", \"reason\": \"compiled clean (-Wall -Wextra -Werror -std=c11)\"}, {\"target\": \"systemverilog\", \"input\": \"c.chw\", \"tool\": \"iverilog (Icarus Verilog version 12.0)\", \"outcome\": \"failed\", \"reason\": \"roundtrip.sv:91: syntax error\\n/tmp/x/report_roundtrip.sv:127: error: Malformed \\\"statement\\\"\\t\\u00e9\\u20ac\\ud83d\\ude00\"}]", "{\"schema\": \"cancho-hdl-report\", \"version\": \"0.1.0\", \"input\": \"c.chw\", \"static\": {\"checks_run\": [\"parse-error\"], \"checks_passed\": 0, \"checks_failed\": 1, \"diagnostics\": [{\"code\": \"parse-error\", \"severity\": \"Error\", \"tier\": \"Static\", \"message\": \"parse error: expected ':' after the register offset (before the access kind), found 'RW'.\", \"related\": [], \"notes\": [], \"subject\": {\"kind\": \"Ir\", \"path\": \"c.chw\"}, \"span\": {\"file\": \"c.chw\", \"start\": {\"line\": 2, \"column\": 26}, \"end\": {\"line\": 2, \"column\": 28}}}]}, \"tested\": {\"roundtrips_run\": [], \"roundtrips_passed\": 0, \"roundtrips_failed\": 0, \"details\": [{\"target\": \"c-header\", \"input\": \"c.chw\", \"outcome\": \"skipped\", \"reason\": \"contract did not parse; generators not run\"}, {\"target\": \"systemverilog\", \"input\": \"c.chw\", \"outcome\": \"skipped\", \"reason\": \"contract did not parse; generators not run\"}]}, \"runtime\": {\"checks_performed\": [], \"checks_passed\": 0, \"checks_failed\": 0, \"details\": []}, \"trust\": {\"boundaries\": [], \"count\": 0}, \"unknown\": {\"items\": [{\"description\": \"c-header roundtrip not run: contract did not parse (generators not run).\", \"tier\": \"Unknown\"}, {\"description\": \"systemverilog roundtrip not run: contract did not parse (generators not run).\", \"tier\": \"Unknown\"}, {\"description\": \"behavioral roundtrip (drive the generated C accessors and the SystemVerilog module through the reference-model scenarios) is not implemented; the Tested tier covers structure only.\", \"tier\": \"Unknown\"}], \"static_checks_not_run\": [\"schema-version-unsupported\", \"block-name-missing\", \"block-base-address-missing\", \"block-bus-width-invalid\", \"block-endianness-unknown\", \"register-name-missing\", \"register-offset-missing\", \"register-offset-non-aligned\", \"register-offset-overflow\", \"register-offset-duplicate\", \"register-kind-unknown\", \"reset-overflow\", \"reset-wo-nonzero\", \"field-name-missing\", \"field-bounds-missing\", \"field-bounds-inverted\", \"field-bounds-overflow\", \"field-overlap\", \"field-enum-overflow\", \"field-constraint-ignored\", \"interrupt-name-missing\", \"interrupt-duplicate-name\", \"interrupt-source-unresolved\", \"interrupt-enable-unresolved\", \"interrupt-status-unresolved\", \"interrupt-clear-unresolved\", \"interrupt-clear-kind-invalid\", \"dma-name-missing\", \"dma-field-name-missing\", \"dma-overlap\", \"dma-align-illegal\", \"dma-align-unsatisfied\", \"dma-owner-unknown\"]}, \"static_checks_run\": [\"parse-error\"], \"tested_roundtrips_run\": [], \"trust_boundaries\": [], \"unknown_items\": [{\"description\": \"c-header roundtrip not run: contract did not parse (generators not run).\", \"tier\": \"Unknown\"}, {\"description\": \"systemverilog roundtrip not run: contract did not parse (generators not run).\", \"tier\": \"Unknown\"}, {\"description\": \"behavioral roundtrip (drive the generated C accessors and the SystemVerilog module through the reference-model scenarios) is not implemented; the Tested tier covers structure only.\", \"tier\": \"Unknown\"}], \"non_guarantees\": [\"Functional correctness of generated RTL beyond the register map itself.\", \"Timing closure.\", \"Area, power, fanout.\", \"Functional correctness of third-party IP.\", \"Driver logic that uses a generated binding.\", \"That 