g\", \"register-offset-non-aligned\", \"register-offset-overflow\", \"register-offset-duplicate\", \"register-kind-unknown\", \"reset-overflow\", \"reset-wo-nonzero\", \"field-name-missing\", \"field-bounds-missing\", \"field-bounds-inverted\", \"field-bounds-overflow\", \"field-overlap\", \"field-enum-overflow\", \"field-constraint-ignored\", \"interrupt-name-missing\", \"interrupt-duplicate-name\", \"interrupt-source-unresolved\", \"interrupt-enable-unresolved\", \"interrupt-status-unresolved\", \"interrupt-clear-unresolved\", \"interrupt-clear-kind-invalid\", \"dma-name-missing\", \"dma-field-name-missing\", \"dma-overlap\", \"dma-align-illegal\", \"dma-align-unsatisfied\", \"dma-owner-unknown\"], \"tested_roundtrips_run\": [], \"trust_boundaries\": [], \"unknown_items\": [{\"description\": \"roundtrips disabled for this run (--no-roundtrips).\", \"tier\": \"Unknown\"}, {\"description\": \"behavioral roundtrip (drive the generated C accessors and the SystemVerilog module through the reference-model scenarios) is not implemented; the Tested tier covers structure only.\", \"tier\": \"Unknown\"}], \"non_guarantees\": [\"Functional correctness of generated RTL beyond the register map itself.\", \"Timing closure.\", \"Area, power, fanout.\", \"Functional correctness of third-party IP.\", \"Driver logic that uses a generated binding.\", \"That every real datasheet quirk has a structured encoding.\", \"That a passing `cancho-hdl check` proves the system works.\", \"That `cancho-hdl diff` flags semantic regressions a human would catch.\", \"That generated output for one vendor toolchain works under another.\"]}") == true);
