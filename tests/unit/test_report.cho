fn strict_holds[&h, &d](heap: &!h Heap, doc: &d [byte]) -> [heap] bool {
    var ok = false;
    let (tape, nodes) = tape_of(heap, doc);
    borrow tape as &tr in {
        ok = report.strict_ok(doc, contents(tr));
    }
    unbox_slice(heap, tape);
    return ok;
}

