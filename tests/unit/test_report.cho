// test_report.cho -- `chw report` (src/report*.cho), one scenario at a time (docs/cancho-port.md, 35.6).
//
// Every expected text below is what `tools/report/report.py` writes for the same contract, taken from the tool by
// tests/differential/report_expected.py, which also writes this file; none is typed. The contract is loaded against the
// empty schema `{}` (a test borrows only the heap), so the schema pass has nothing to refuse and the scenarios are the
// ones the checker's rules decide.
//
//     cancho test tests/unit/test_report.cho tests/unit/support.cho src/*.cho --std
//     (all of src/ except main.cho and conform.cho)

import std.buffer;
import std.bytes;
import std.json;
import std.test;
import chw.diff_fmt;
import chw.load;
import chw.report;
import chw.report_check;
import tsup;

fn tape_of[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (Box[[int]], int) {
    let tape = box_slice(heap, json.tape_len(text), 0);
    var nodes = 0;
    borrow mut tape as &!w in {
        nodes = json.parse(text, contents(w));
    }
    return (tape, nodes);
}

// The report `build` writes for `contract` (mode 0 no lanes, 1 lanes, 2 none) and `lanes`.
fn built[&h, &c, &l](heap: &!h Heap, contract: &c [byte], mode: int, lanes: &l [byte]) -> [heap] buffer.Buffer {
    let sch = tsup.schema_of(heap, "{}");
    var out = buffer.empty(heap, 16);
    borrow sch as &sr in {
        let loaded = load.load(heap, contract, sr);
        borrow loaded as &lr in {
            let (lt, ln) = tape_of(heap, lanes);
            borrow lt as &ltr in {
                buffer.drop(heap, out);
                out = report.build(heap, lr, "c.chw", contract, mode, lanes, contents(ltr));
            }
            unbox_slice(heap, lt);
        }
        load.drop(heap, loaded);
    }
    load.drop_schema(heap, sch);
    return out;
}

fn same[&h, &c, &l, &w](heap: &!h Heap, contract: &c [byte], mode: int, lanes: &l [byte], want: &w [byte]) -> [heap] int {
    let out = built(heap, contract, mode, lanes);
    var ok = false;
    borrow out as &or in {
        ok = bytes.equal(buffer.bytes(or), want);
    }
    buffer.drop(heap, out);
    return test.assert(ok);
}

// `format_text`, `--pretty` and `--strict` of the report `text`.
fn as_text[&h, &d](heap: &!h Heap, doc: &d [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    let (tape, nodes) = tape_of(heap, doc);
    borrow tape as &tr in {
        buffer.drop(heap, out);
        out = report.text(heap, buffer.empty(heap, 512), doc, contents(tr));
    }
    unbox_slice(heap, tape);
    return out;
}

fn pretty_of[&h, &d](heap: &!h Heap, doc: &d [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    let (tape, nodes) = tape_of(heap, doc);
    borrow tape as &tr in {
        buffer.drop(heap, out);
        out = diff_fmt.pretty(heap, buffer.empty(heap, 512), doc, contents(tr), 0, 0);
    }
    unbox_slice(heap, tape);
    return out;
}

fn refusals_of[&h, &d](heap: &!h Heap, doc: &d [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    let (tape, nodes) = tape_of(heap, doc);
    if nodes < 0 {
        buffer.drop(heap, out);
        out = buffer.append(heap, buffer.empty(heap, 16), "not json");
    } else {
        borrow tape as &tr in {
            buffer.drop(heap, out);
            out = report_check.validate(heap, buffer.empty(heap, 128), doc, contents(tr));
        }
    }
    unbox_slice(heap, tape);
    return out;
}

fn refused_as[&h, &d, &w](heap: &!h Heap, doc: &d [byte], want: &w [byte]) -> [heap] int {
    let out = refusals_of(heap, doc);
    var ok = false;
    borrow out as &or in {
        ok = bytes.equal(buffer.bytes(or), want);
    }
    buffer.drop(heap, out);
    return test.assert(ok);
}

fn test_clean_no_roundtrips[&h](heap: &!h Heap) -> [heap] int {
    return same(heap, "{\"version\":\"0.1.0\",\"block\":{\"name\":\"B\",\"base_address\":\"0x40\",\"bus_width\":32,\"endianness\":\"little\",\"registers\":[{\"name\":\"R\",\"offset\":\"0x00\",\"kind\":\"RW\",\"reset\":\"0x0\",\"fields\":[{\"name\":\"F\",\"lsb\":0,\"msb\":3,\"enum\":{\"A\":0,\"B\":1}},{\"name\":\"G\",\"lsb\":8,\"msb\":9}]},{\"name\":\"S\",\"offset\":\"0x04\",\"kind\":\"RO\"}],\"interrupts\":[{\"name\":\"I\",\"number\":1,\"source\":{\"register\":\"R\",\"field\":\"F\"},\"clear\":{\"register\":\"R\",\"field\":\"G\",\"kind\":\"W1C\"}}]},\"dma_buffers\":[{\"name\":\"D\",\"fields\":[{\"name\":\"X\",\"offset\":\"0x0\",\"owner\":\"CPU\"},{\"name\":\"Y\",\"offset\":\"0x4\",\"owner\":\"DEVICE\"}]}]}", 2, "[]", "{\"schema\": \"cancho-hdl-report\", \"version\": \"0.1.0\", \"input\": \"c.chw\", \"static\": {\"checks_run\": [\"schema-invalid\", \"block-name-missing\", \"block-base-address-missing\", \"block-bus-width-invalid\", \"block-endianness-unknown\", \"register-name-missing\", \"register-offset-missing\", \"register-offset-non-aligned\", \"register-offset-overflow\", \"register-offset-duplicate\", \"register-kind-unknown\", \"reset-overflow\", \"reset-wo-nonzero\", \"field-name-missing\", \"field-bounds-missing\", \"field-bounds-inverted\", \"field-bounds-overflow\", \"field-overlap\", \"field-enum-overflow\", \"field-constraint-ignored\", \"interrupt-name-missing\", \"interrupt-duplicate-name\", \"interrupt-source-unresolved\", \"interrupt-enable-unresolved\", \"interrupt-status-unresolved\", \"interrupt-clear-unresolved\", \"interrupt-clear-kind-invalid\", \"dma-name-missing\", \"dma-field-name-missing\", \"dma-overlap\", \"dma-align-illegal\", \"dma-align-unsatisfied\", \"dma-owner-unknown\"], \"checks_passed\": 33, \"checks_failed\": 0, \"diagnostics\": []}, \"tested\": {\"roundtrips_run\": [], \"roundtrips_passed\": 0, \"roundtrips_failed\": 0, \"details\": []}, \"runtime\": {\"checks_performed\": [\"schema-version-unsupported\"], \"checks_passed\": 1, \"checks_failed\": 0, \"details\": []}, \"trust\": {\"boundaries\": [], \"count\": 0}, \"unknown\": {\"items\": [{\"description\": \"roundtrips disabled for this run (--no-roundtrips).\", \"tier\": \"Unknown\"}, {\"description\": \"behavioral roundtrip (drive the generated C accessors and the SystemVerilog module through the reference-model scenarios) is not implemented; the Tested tier covers structure only.\", \"tier\": \"Unknown\"}], \"static_checks_not_run\": []}, \"static_checks_run\": [\"schema-invalid\", \"block-name-missing\", \"block-base-address-missing\", \"block-bus-width-invalid\", \"block-endianness-unknown\", \"register-name-missing\", \"register-offset-missing\", \"register-offset-non-aligned\", \"register-offset-overflow\", \"register-offset-duplicate\", \"register-kind-unknown\", \"reset-overflow\", \"reset-wo-nonzero\", \"field-name-missing\", \"field-bounds-missing\", \"field-bounds-inverted\", \"field-bounds-overflow\", \"field-overlap\", \"field-enum-overflow\", \"field-constraint-ignored\", \"interrupt-name-missing\", \"interrupt-duplicate-name\", \"interrupt-source-unresolved\", \"interrupt-enable-unresolved\", \"interrupt-status-unresolved\", \"interrupt-clear-unresolved\", \"interrupt-clear-kind-invalid\", \"dma-name-missing\", \"dma-field-name-missing\", \"dma-overlap\", \"dma-align-illegal\", \"dma-align-unsatisfied\", \"dma-owner-unknown\"], \"tested_roundtrips_run\": [], \"trust_boundaries\": [], \"unknown_items\": [{\"description\": \"roundtrips disabled for this run (--no-roundtrips).\", \"tier\": \"Unknown\"}, {\"description\": \"behavioral roundtrip (drive the generated C accessors and the SystemVerilog module through the reference-model scenarios) is not implemented; the Tested tier covers structure only.\", \"tier\": \"Unknown\"}], \"non_guarantees\": [\"Functional correctness of generated RTL beyond the register map itself.\", \"Timing closure.\", \"Area, power, fanout.\", \"Functional correctness of third-party IP.\", \"Driver logic that uses a generated binding.\", \"That every real datasheet quirk has a structured encoding.\", \"That a passing `cancho-hdl check` proves the system works.\", \"That `cancho-hdl diff` flags semantic regressions a human would catch.\", \"That generated output for one vendor toolchain works under another.\"]}");
}

