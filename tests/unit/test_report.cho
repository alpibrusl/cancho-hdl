fn has[&h, &c, &l, &f](heap: &!h Heap, contract: &c [byte], fragment: &f [byte]) -> [heap] bool {
    let out = built(heap, contract, 2, "[]");
    var found = false;
    borrow out as &or in {
        found = bytes.find(buffer.bytes(or), fragment) >= 0;
    }
    buffer.drop(heap, out);
    return found;
}

fn test_json_that_is_not_json_is_a_schema_refusal_that_fired[&h](heap: &!h Heap) -> [heap] int {
    return test.assert(has(heap, "{", "\"checks_run\": [\"schema-invalid\"], \"checks_passed\": 0, \"checks_failed\": 1") && has(heap, "{", "\"static_checks_not_run\": [\"schema-version-unsupported\", \"block-name-missing\", \"block-base-address-missing\", \"block-bus-width-invalid\", \"block-endianness-unknown\", \"register-name-missing\", \"register-offset-missing\", \"register-offset-non-aligned\", \"register-offset-overflow\", \"register-offset-duplicate\", \"register-kind-unknown\", \"reset-overflow\", \"reset-wo-nonzero\", \"field-name-missing\", \"field-bounds-missing\", \"field-bounds-inverted\", \"field-bounds-overflow\", \"field-overlap\", \"field-enum-overflow\", \"field-constraint-ignored\", \"interrupt-name-missing\", \"interrupt-duplicate-name\", \"interrupt-source-unresolved\", \"interrupt-enable-unresolved\", \"interrupt-status-unresolved\", \"interrupt-clear-unresolved\", \"interrupt-clear-kind-invalid\", \"dma-name-missing\", \"dma-field-name-missing\", \"dma-overlap\", \"dma-align-illegal\", \"dma-align-unsatisfied\", \"dma-owner-unknown\"]") && has(heap, "{", "\"checks_performed\": [], \"checks_passed\": 0"));
}

fn test_clean_lane_passed_and_failed_as_text[&h](heap: &!h Heap) -> [heap] int {
    let doc = "{\"schema\": \"cancho-hdl-report\", \"version\": \"0.1.0\", \"input\": \"c.chw\", \"static\": {\"checks_run\": [\"schema-invalid\", \"block-name-missing\", \"block-base-address-missing\", \"block-bus-width-invalid\", \"block-endianness-unknown\", \"register-name-missing\", \"register-offset-missing\", \"register-offset-non-aligned\", \"register-offset-overflow\", \"register-offset-duplicate\", \"register-kind-unknown\", \"reset-overflow\", \"reset-wo-nonzero\", \"field-name-missing\", \"field-bounds-missing\", \"field-bounds-inverted\", \"field-bounds-overflow\", \"field-overlap\", \"field-enum-overflow\", \"field-constraint-ignored\", \"interrupt-name-missing\", \"interrupt-duplicate-name\", \"interrupt-source-unresolved\", \"interrupt-enable-unresolved\", \"interrupt-status-unresolved\", \"interrupt-clear-unresolved\", \"interrupt-clear-kind-invalid\", \"dma-name-missing\", \"dma-field-name-missing\", \"dma-overlap\", \"dma-align-illegal\", \"dma-align-unsatisfied\", \"dma-owner-unknown\"], \"checks_passed\": 33, \"checks_failed\": 0, \"diagnostics\": []}, \"tested\": {\"roundtrips_run\": [\"c-header::clang\", \"systemverilog::iverilog\"], \"roundtrips_passed\": 1, \"roundtrips_failed\": 1, \"details\": [{\"target\": \"c-header\", \"input\": \"c.chw\", \"tool\": \"clang (Ubuntu clang version 18.1.3 (1ubuntu1))\", \"outcome\": \"passed\", \"reason\": \"compiled clean (-Wall -Wextra -Werror -std=c11)\"}, {\"target\": \"systemverilog\", \"input\": \"c.chw\", \"tool\": \"iverilog (Icarus Verilog version 12.0)\", \"outcome\": \"failed\", \"reason\": \"roundtrip.sv:91: syntax error\\n/tmp/x/report_roundtrip.sv:127: error: Malformed \\\"statement\\\"\\t\\u00e9\\u20ac\\ud83d\\ude00\"}]}, \"runtime\": {\"checks_performed\": [\"schema-version-unsupported\"], \"checks_passed\": 1, \"checks_failed\": 0, \"details\": []}, \"trust\": {\"boundaries\": [{\"tool\": \"clang (Ubuntu clang version 18.1.3 (1ubuntu1))\", \"tier\": \"Trust\", \"why\": \"the roundtrip's verdict is this tool's output; not re-verified here\"}], \"count\": 1}, \"unknown\": {\"items\": [{\"description\": \"behavioral roundtrip (drive the generated C accessors and the SystemVerilog module through the reference-model scenarios) is not implemented; the Tested tier covers structure only.\", \"tier\": \"Unknown\"}], \"static_checks_not_run\": []}, \"static_checks_run\": [\"schema-invalid\", \"block-name-missing\", \"block-base-address-missing\", \"block-bus-width-invalid\", \"block-endianness-unknown\", \"register-name-missing\", \"register-offset-missing\", \"register-offset-non-aligned\", \"register-offset-overflow\", \"register-offset-duplicate\", \"register-kind-unknown\", \"reset-overflow\", \"reset-wo-nonzero\", \"field-name-missing\", \"field-bounds-missing\", \"field-bounds-inverted\", \"field-bounds-overflow\", \"field-overlap\", \"field-enum-overflow\", \"field-constraint-ignored\", \"interrupt-name-missing\", \"interrupt-duplicate-name\", \"interrupt-source-unresolved\", \"interrupt-enable-unresolved\", \"interrupt-status-unresolved\", \"interrupt-clear-unresolved\", \"interrupt-clear-kind-invalid\", \"dma-name-missing\", \"dma-field-name-missing\", \"dma-overlap\", \"dma-align-illegal\", \"dma-align-unsatisfied\", \"dma-owner-unknown\"], \"tested_roundtrips_run\": [\"c-header::clang\", \"systemverilog::iverilog\"], \"trust_boundaries\": [\"clang (Ubuntu clang version 18.1.3 (1ubuntu1))\"], \"unknown_items\": [{\"description\": \"behavioral roundtrip (drive the generated C accessors and the SystemVerilog module through the reference-model scenarios) is not implemented; the Tested tier covers structure only.\", \"tier\": \"Unknown\"}], \"non_guarantees\": [\"Functional correctness of generated RTL beyond the register map itself.\", \"Timing closure.\", \"Area, power, fanout.\", \"Functional correctness of third-party IP.\", \"Driver logic that uses a generated binding.\", \"That every real datasheet quirk has a structured encoding.\", \"That a passing `cancho-hdl check` proves the system works.\", \"That `cancho-hdl diff` flags semantic regressions a human would catch.\", \"That generated output for one vendor toolchain works under another.\"]}";
    let out = as_text(heap, doc);
    var ok = false;
    borrow out as &or in {
        ok = bytes.equal(buffer.bytes(or), "== cancho-hdl report: c.chw ==\nstatic   : 33 checks run, 33 passed, 0 failed\ntested   : 2 roundtrip(s) run, 1 passed, 1 failed\nruntime  : 1 check(s) performed, 1 passed, 0 failed\ntrust    : 1 boundary/boundaries — clang\nunknown  : 1 item(s); 0 static check(s) not run — see the JSON for both lists\nnon_guarantees: 9 rows restated verbatim (docs/guarantees.md §2) — see the JSON\n");
    }
    buffer.drop(heap, out);
    return test.assert(ok);
}

