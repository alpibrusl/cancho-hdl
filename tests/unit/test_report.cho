fn lanes_code[&h, &d](heap: &!h Heap, doc: &d [byte]) -> [heap] int {
    var code = 0 - 1;
    let (tape, nodes) = tape_of(heap, doc);
    borrow tape as &tr in {
        code = report.lanes_check(doc, contents(tr));
    }
    unbox_slice(heap, tape);
    return code;
}

fn test_lanes_an_array_of_two_good_lanes[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\": \"c-header\", \"input\": \"c.chw\", \"tool\": \"clang (Ubuntu clang version 18.1.3 (1ubuntu1))\", \"outcome\": \"passed\", \"reason\": \"compiled clean (-Wall -Wextra -Werror -std=c11)\"}, {\"target\": \"systemverilog\", \"input\": \"c.chw\", \"tool\": \"iverilog (Icarus Verilog version 12.0)\", \"outcome\": \"failed\", \"reason\": \"roundtrip.sv:91: syntax error\\n/tmp/x/report_roundtrip.sv:127: error: Malformed \\\"statement\\\"\\t\\u00e9\\u20ac\\ud83d\\ude00\"}]"), 0);
}

fn test_lanes_an_empty_array[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[]"), 0);
}

fn test_lanes_one_lane_alone[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\": \"systemverilog\", \"input\": \"c.chw\", \"tool\": \"iverilog (unknown version)\", \"outcome\": \"passed\", \"reason\": \"iverilog -g2012 parse clean\"}]"), 0);
}

fn test_lanes_a_skipped_lane_needs_no_tool[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"outcome\":\"skipped\",\"reason\":\"r\"}]"), 0);
}

fn test_lanes_an_object[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "{\"target\":\"c-header\"}"), 1);
}

fn test_lanes_an_entry_that_is_not_an_object[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[\"c-header\"]"), 2);
}

fn test_lanes_a_target_that_is_neither[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"vhdl\",\"outcome\":\"skipped\",\"reason\":\"r\"}]"), 3);
}

fn test_lanes_a_target_that_is_missing[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"outcome\":\"skipped\",\"reason\":\"r\"}]"), 3);
}

fn test_lanes_c_header_twice[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"outcome\":\"skipped\",\"reason\":\"r\"},{\"target\":\"c-header\",\"outcome\":\"skipped\",\"reason\":\"r\"}]"), 4);
}

fn test_lanes_systemverilog_twice[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"systemverilog\",\"outcome\":\"skipped\",\"reason\":\"r\"},{\"target\":\"systemverilog\",\"outcome\":\"skipped\",\"reason\":\"r\"}]"), 4);
}

fn test_lanes_an_outcome_that_is_not_one[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"outcome\":\"ok\",\"tool\":\"t\",\"reason\":\"r\"}]"), 5);
}

fn test_lanes_an_outcome_that_is_missing[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"tool\":\"t\",\"reason\":\"r\"}]"), 5);
}

fn test_lanes_a_reason_that_is_missing[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"outcome\":\"skipped\"}]"), 6);
}

fn test_lanes_a_reason_that_is_not_a_string[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"outcome\":\"skipped\",\"reason\":1}]"), 6);
}

fn test_lanes_a_tool_that_is_not_a_string[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"outcome\":\"skipped\",\"tool\":1,\"reason\":\"r\"}]"), 7);
}

fn test_lanes_a_passed_lane_with_no_tool[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"c-header\",\"outcome\":\"passed\",\"reason\":\"r\"}]"), 8);
}

fn test_lanes_a_failed_lane_with_no_tool[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"systemverilog\",\"outcome\":\"failed\",\"reason\":\"r\"}]"), 8);
}

fn test_lanes_a_lane_with_a_null_tool[&h](heap: &!h Heap) -> [heap] int {
    return test.assert_eq(lanes_code(heap, "[{\"target\":\"systemverilog\",\"outcome\":\"failed\",\"tool\":null,\"reason\":\"r\"}]"), 7);
}

fn test_every_lanes_reason_is_worded_and_distinct() -> [] int {
    var i = 1;
    var ok = true;
    while i <= 8 {
        var j = i + 1;
        while j <= 8 {
            if bytes.equal(report.lanes_reason(i), report.lanes_reason(j)) {
                ok = false;
            }
            j = j + 1;
        }
        if len(report.lanes_reason(i)) == 0 {
            ok = false;
        }
        i = i + 1;
    }
    return test.assert(ok);
}

