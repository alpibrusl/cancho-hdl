// test_gen_dts.cho -- the device-tree generator (src/gen_dts.cho, docs/cancho-port.md 20): a fragment with
// interrupts, the snake-casing of the Python tool's two regular expressions, the refusals, and an IR a
// checker would have refused.
//
//     cancho test tests/unit/test_gen_dts.cho <the library> --std

import std.buffer;
import std.bytes;
import std.test;
import chw.front;
import chw.gen_dts;
import chw.ir as model;

fn with_irqs() -> [] &static [byte] {
    return "register-block DmaCtrl @ 0x4000_1000, width 32, little-endian {\n    register S @ 0x10 : W1C {\n        field Done : bits [0..0]\n        field Err : bits [1..1]\n    }\n    register E @ 0x14 : RW {\n        field DoneEn : bits [0..0]\n        field ErrEn : bits [1..1]\n    }\n    interrupt tx from S.Done {\n        number 7\n        source @ S.Done\n        status @ S.Done\n        enable @ E.DoneEn\n        clear @ S.Done\n    }\n    interrupt err from S.Err {\n        number 9\n        source @ S.Err\n        status @ S.Err\n        enable @ E.ErrEn\n        clear @ S.Err\n    }\n}\n";
}

fn plain(name: &static [byte]) -> [] &static [byte] {
    return name;
}

// The fragment (or the refusal text) of the text-form contract `text`, and its status.
fn run[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (buffer.Buffer, int) {
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow ir as &q in {
        buffer.drop(heap, got);
        let (out, st) = gen_dts.generate(heap, text, "t.chw", q);
        got = out;
        status = st;
    }
    model.drop(heap, ir);
    return (got, status);
}

// A one-register block named `name`, at `base`, as text.
fn block[&h, &n, &b](heap: &!h Heap, name: &n [byte], base: &b [byte]) -> [heap] (buffer.Buffer, int) {
    var src = buffer.append(heap, buffer.empty(heap, 96), "register-block ");
    src = buffer.append(heap, src, name);
    src = buffer.append(heap, src, " @ ");
    src = buffer.append(heap, src, base);
    src = buffer.append(heap, src, ", width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    var got = buffer.empty(heap, 1);
    var status = 0 - 1;
    borrow src as &sr in {
        buffer.drop(heap, got);
        let (out, st) = run(heap, buffer.bytes(sr));
        got = out;
        status = st;
    }
    buffer.drop(heap, src);
    return (got, status);
}

fn has[&b, &n](haystack: &b buffer.Buffer, needle: &n [byte]) -> [] bool {
    return bytes.find(buffer.bytes(haystack), needle) >= 0;
}

fn test_a_block_with_two_interrupts_is_written_as_the_python_tool_writes_it[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, with_irqs());
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "/* Generated by cancho-hdl from t.chw. Do not edit. */\n&soc {\n    dma_ctrl: dma_ctrl@40001000 {\n        /* chw:DmaCtrl */\n"));
        test.assert(has(o, "        compatible = \"cancho,dma-ctrl-v0\";\n        reg = <0x40001000 0x18>;\n"));
        test.assert(has(o, "        interrupt-parent = <&intc>;\n        interrupts = <7 4>,\n                     <9 4>;\n"));
        test.assert(has(o, "        /* chw:DmaCtrl.interrupt.tx, IRQ 7 */\n        /* chw:DmaCtrl.interrupt.err, IRQ 9 */\n"));
        test.assert(has(o, "        #address-cells = <1>;\n        #size-cells = <1>;\n        bus-width = <32>;\n    };\n};\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_block_without_interrupts_has_no_interrupt_property[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = block(heap, "Blk", "0x0");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "    blk: blk@0 {\n"));
        test.assert(has(o, "        reg = <0x0 0x4>;\n"));
        test.assert(!has(o, "interrupt"));
    }
    buffer.drop(heap, out);
    return 0;
}

// The two passes of `_snake`: a capital run ends at the capital before a lower-case letter, then a capital after a
// lower-case letter or a digit starts a word.
fn test_names_are_snake_cased_by_the_two_regular_expressions_of_the_python_tool[&h](heap: &!h Heap) -> [heap] int {
    let (a, sa) = block(heap, "UartCTRLx", "0x0");
    test.assert_eq(sa, 0);
    borrow a as &o in {
        test.assert(has(o, "    uart_ctr_lx: uart_ctr_lx@0 {\n"));
        test.assert(has(o, "\"cancho,uart-ctr-lx-v0\""));
    }
    buffer.drop(heap, a);
    let (b, sb) = block(heap, "HTTPServer2Name", "0x0");
    test.assert_eq(sb, 0);
    borrow b as &o2 in {
        test.assert(has(o2, "    http_server2_name: http_server2_name@0 {\n"));
    }
    buffer.drop(heap, b);
    let (c, sc) = block(heap, "aBCd", "0x0");
    test.assert_eq(sc, 0);
    borrow c as &o3 in {
        test.assert(has(o3, "    a_b_cd: a_b_cd@0 {\n"));
    }
    buffer.drop(heap, c);
    return 0;
}

fn test_the_unit_address_is_upper_case_hex_without_padding[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = block(heap, "B", "0xabcd_ef01");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "    b: b@ABCDEF01 {\n"));
        test.assert(has(o, "        reg = <0xABCDEF01 0x4>;\n"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_block_with_no_register_is_refused_with_the_python_tools_words[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x0, width 32, little-endian {\n}\n");
    test.assert_eq(st, gen_dts.status_refused());
    borrow out as &o in {
        test.assert(has(o, "devicetree fragment with zero registers: the reg range is undefined; declare at least one register"));
    }
    buffer.drop(heap, out);
    return 0;
}

fn test_a_base_that_does_not_fit_one_address_cell_is_refused_not_widened[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = block(heap, "B", "0x100000000");
    test.assert_eq(st, gen_dts.status_refused());
    borrow out as &o in {
        test.assert(has(o, "base_address 0x100000000 does not fit a single 32-bit address cell (#address-cells = <1>); refusing, not widening"));
    }
    buffer.drop(heap, out);
    let (big, st2) = block(heap, "B", "0x1ffffffffffffffffff");
    test.assert_eq(st2, gen_dts.status_refused());
    borrow big as &o2 in {
        test.assert(has(o2, "base_address 0x1FFFFFFFFFFFFFFFFFF does not fit"));
    }
    buffer.drop(heap, big);
    let (edge, st3) = block(heap, "B", "0xffffffff");
    test.assert_eq(st3, 0);
    buffer.drop(heap, edge);
    return 0;
}

fn test_a_name_that_is_not_a_label_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block A-B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, gen_dts.status_refused());
    buffer.drop(heap, out);
    return 0;
}

// A block with one register and spans over `src`, for the tests that need an IR no checker would pass.
fn one_register[&h](heap: &!h Heap, off_s: int, off_e: int) -> [heap] model.Ir {
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    return model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: off_s, off_e: off_e, kind_s: 0, kind_e: 0, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
}

fn test_a_register_offset_that_is_not_a_number_is_internal[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40RZZZ";
    let ir = one_register(heap, 6, 9);
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_dts.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_dts.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_register_offset_past_2_to_the_60_is_refused_not_wrapped[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x1000000000000000000";
    let ir = one_register(heap, 6, 27);
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_dts.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_dts.status_refused());
    borrow text as &o in {
        test.assert(has(o, "is past 2^60"));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_the_major_of_the_schema_version_is_the_text_before_the_first_dot[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x02.1.0";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 9, ver_e: 14, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 0, kind_e: 0, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_dts.generate(heap, src, "t.chw", q);
        text = out;
        test.assert_eq(st, 0);
    }
    borrow text as &o in {
        test.assert(has(o, "\"cancho,b-v2\""));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_negative_bus_width_is_internal_not_a_size[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x0";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 0 - 8, big: false, ver_s: 0 - 1, ver_e: 0, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 0, kind_e: 0, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_dts.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_dts.status_internal());
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

// A version with a JSON escape is a span of the raw document, not the decoded string: refused, not written.
fn test_a_version_with_an_escape_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let src = "B0x40R0x01\\u0030";
    var ir = model.empty(heap);
    ir = model.set_block(ir, model.Block { name_s: 0, name_e: 1, base_s: 1, base_e: 5, width: 32, big: false, ver_s: 9, ver_e: 15, sch_s: 0 - 1, sch_e: 0, has_schema: true });
    ir = model.add_reg(heap, ir, model.Reg { name_s: 5, name_e: 6, off_s: 6, off_e: 9, kind_s: 0, kind_e: 0, reset_s: 0 - 1, reset_e: 0, volatile: false, polling: false, order: 0, first: 0, n: 0 });
    var status = 0 - 1;
    var text = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, text);
        let (out, st) = gen_dts.generate(heap, src, "t.chw", q);
        text = out;
        status = st;
    }
    test.assert_eq(status, gen_dts.status_refused());
    borrow text as &o in {
        test.assert(has(o, "the schema version"));
    }
    buffer.drop(heap, text);
    model.drop(heap, ir);
    return 0;
}

fn test_a_source_path_that_would_end_the_comment_is_refused[&h](heap: &!h Heap) -> [heap] int {
    let text = "register-block B @ 0x0, width 32, little-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n";
    let (ir, report) = front.parse_text(heap, text);
    buffer.drop(heap, report);
    var status = 0 - 1;
    var got = buffer.empty(heap, 1);
    borrow ir as &q in {
        buffer.drop(heap, got);
        let (out, st) = gen_dts.generate(heap, text, "a*/b.chw", q);
        got = out;
        status = st;
        let (ok, st2) = gen_dts.generate(heap, text, "a/*b.chw", q);
        test.assert_eq(st2, 0);
        buffer.drop(heap, ok);
    }
    test.assert_eq(status, gen_dts.status_refused());
    borrow got as &o in {
        test.assert(has(o, "the source path 'a*/b.chw'"));
    }
    buffer.drop(heap, got);
    model.drop(heap, ir);
    return 0;
}

// `big` in the IR is the endianness, not a size: a big-endian block is written like a little-endian one.
fn test_a_big_endian_block_is_written_like_any_other[&h](heap: &!h Heap) -> [heap] int {
    let (out, st) = run(heap, "register-block B @ 0x10, width 32, big-endian {\n    register R @ 0x0 : RW {\n        field A : bits [0..0]\n    }\n}\n");
    test.assert_eq(st, 0);
    borrow out as &o in {
        test.assert(has(o, "    b: b@10 {\n"));
        test.assert(has(o, "        reg = <0x10 0x4>;\n"));
    }
    buffer.drop(heap, out);
    return 0;
}
