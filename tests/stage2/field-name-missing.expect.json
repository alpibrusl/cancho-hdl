{
  "file": "tests/stage2/field-name-missing.chw",
  "expect": [
    {
      "code": "schema-invalid",
      "subject": {
        "kind": "Ir"
      },
      "message_contains": "'name' is a required property"
    },
    {
      "code": "field-name-missing",
      "subject": {
        "kind": "Field",
        "block": "Dev",
        "register": "CTRL",
        "name": "<missing>"
      },
      "message_contains": "field in register 'CTRL' is missing required 'name'."
    },
    {
      "code": "interrupt-enable-unresolved",
      "subject": {
        "kind": "InterruptLinkage",
        "block": "Dev",
        "interrupt": "rx",
        "role": "enable"
      },
      "message_contains": "interrupt rx enable references CTRL.EN does not exist: field EN is not declared on register CTRL."
    },
    {
      "code": "interrupt-clear-unresolved",
      "subject": {
        "kind": "InterruptLinkage",
        "block": "Dev",
        "interrupt": "rx",
        "role": "clear"
      },
      "message_contains": "interrupt rx clear references CTRL.EN does not exist: field EN is not declared on register CTRL."
    }
  ]
}
