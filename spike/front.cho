module chw.front;

// front.cho -- text in, JSON or refusal out, as a pure function of bytes.
// The driver prints the answer and the tests compare it; neither knows how
// it was made.

import std.buffer;
import chw.lex as lx;
import chw.ir as model;
import chw.parse;
import chw.json;

// The refusal line, in the Python tool's words:
// `error[parse-error]: MSG  path:line:col`.
fn refusal[&h, &p, &s](heap: &!h Heap, path: &p [byte], st: &!s [int]) -> [heap] buffer.Buffer {
    var out = buffer.append(heap, buffer.empty(heap, 256), "error[parse-error]: ");
    var k = 0;
    while k < parse.msg_len(st) {
        out = buffer.push(heap, out, byte_of(parse.msg_byte(st, k)));
        k = k + 1;
    }
    out = buffer.append(heap, out, "  ");
    out = buffer.append(heap, out, path);
    out = buffer.push(heap, out, byte_of(':'));
    out = buffer.push_nat(heap, out, parse.err_line(st));
    out = buffer.push(heap, out, byte_of(':'));
    out = buffer.push_nat(heap, out, parse.err_col(st));
    return buffer.push(heap, out, byte_of('\n'));
}

// Parse `text`. Answers the JSON line and 0, or the refusal line and 1. The
// buffer is the caller's to drop either way.
pub fn parse_chw[&h, &t, &p](heap: &!h Heap, path: &p [byte], text: &t [byte]) -> [heap] (buffer.Buffer, int) {
    let toks = box_slice(heap, len(text) + 2, lx.blank());
    let st = box_slice(heap, parse.state_size(), 0);
    var count = 0;
    borrow mut toks as &!tw in {
        count = lx.lex(text, contents(tw));
    }
    var out = buffer.empty(heap, 16);
    var status = 0;
    borrow toks as &tr in {
        borrow mut st as &!sw in {
            parse.start(contents(sw), count);
            let ir = parse.parse_file(heap, text, contents(tr), contents(sw), model.empty(heap));
            buffer.drop(heap, out);
            if parse.failed(contents(sw)) {
                status = 1;
                out = refusal(heap, path, contents(sw));
            } else {
                borrow ir as &q in {
                    out = json.render(heap, text, q);
                }
                out = buffer.push(heap, out, byte_of('\n'));
            }
            model.drop(heap, ir);
        }
    }
    unbox_slice(heap, st);
    unbox_slice(heap, toks);
    return (out, status);
}
