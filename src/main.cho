edition 6;

// main.cho -- the `chw` command line (docs/cancho-port.md, 9.2).
//
//     chw parse FILE                  load FILE (text or JSON form), print the IR as one
//                                     line of JSON; no schema check (parser.py FILE)
//     chw validate FILE [--schema S] [--machine] [--output json] [--located]
//                                     load and validate against the schema S (default
//                                     spec/contract-schema/cancho-hdl-contract.schema.json),
//                                     print every refusal
//     chw check FILE [--schema S] [--output text|json] [--located]
//                                     validate, then run every semantic rule (checker.py FILE):
//                                     the text form, or the JSON of `--output json`, which is
//                                     the Python checker's byte for byte (--located adds the
//                                     position of the node a structural refusal names)
//     chw generate FILE --target T [--schema S]
//                                     the artifact of target T for a contract the checker accepts
//                                     (oracle/legacy/tools/generate/generate.py): c-header and devicetree are ported
//     chw report FILE [--schema S] [--output json|text] [--pretty] [--strict] [--no-roundtrips] [--lanes FILE]
//                                     the evidence report of oracle/legacy/tools/report/report.py (docs/cancho-port.md, 35);
//                                     the roundtrips are read from the oracle's results (--lanes), the product runs no tool
//     chw report --validate DOC       the refusals report.py's `validate_report` gives a report in the file DOC
//     chw catalog                     every rule with its subject, severity and tier
//     chw conform [ROOT] [--fixtures DIR[,DIR...]]
//                                     run the examples and the refusal fixtures under ROOT
//                                     (default .) through the loader, validator and checker
//
// Exit 0 clean, 1 something was refused or mismatched, 2 usage or the tool itself could
// not run (an unreadable file or schema, a schema keyword this validator lacks).

import std.buffer;
import std.bytes;
import std.io as console;
import std.json;
import chw.conform;
import chw.dg_json;
import chw.dg_text;
import chw.diag;
import chw.diagnostic as dg;
import chw.diff;
import chw.diff_fmt;
import chw.diff_util as du;
import chw.impact;
import chw.gen_c;
import chw.gen_binding;
import chw.gen_dts;
import chw.gen_sv;
import chw.gen_svd;
import chw.io as chwio;
import chw.load;
import chw.pyrepr;
import chw.report;
import chw.report_check;

fn usage[&i](io: &!i Io) -> [err_write] int {
    console.error_all(io, "usage: chw parse FILE | chw validate FILE [--schema S] [--machine] [--output json] [--located] | chw check FILE [--schema S] [--output text|json] [--located] [--ran] | chw generate FILE --target T [--schema S] | chw diff BASE CANDIDATE [--schema S] [--pretty] | chw impact BASE CANDIDATE [--schema S] [--pretty] | chw report FILE [--schema S] [--output json|text] [--pretty] [--strict] [--no-roundtrips] [--lanes FILE] | chw report --validate DOC | chw catalog | chw conform [ROOT] [--fixtures DIR[,DIR...]]\n");
    return 2;
}

// The index of the flag `name` among the arguments, or -1.
fn flag_at[&g](g: &g Args, name: &static [byte]) -> [args] int {
    var i = 1;
    while i < arg_count(g) {
        if bytes.equal(arg(g, i), name) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn schema_path[&g](g: &g Args) -> [args] &g [byte] {
    let at = flag_at(g, "--schema");
    if at > 0 && at + 1 < arg_count(g) {
        return arg(g, at + 1);
    }
    return "spec/contract-schema/cancho-hdl-contract.schema.json";
}

fn output_is_json[&g](g: &g Args) -> [args] bool {
    let at = flag_at(g, "--output");
    return at > 0 && at + 1 < arg_count(g) && bytes.equal(arg(g, at + 1), "json");
}

// Print the diagnostics `ds` of the file `path` (whose text is `source`) as
// JSON or as text, to standard output; the answer is the exit status: 1 if any
// is an Error, 2 if any is the tool's own fault, else 0.
fn show_diags[&h, &i, &q, &p, &s](heap: &!h Heap, io: &!i Io, ds: &q dg.Diags, path: &p [byte], source: &s [byte], as_json: bool, located: bool) -> [heap, io_write] int {
    var out = buffer.empty(heap, 256);
    if as_json {
        out = dg_json.render(heap, out, ds, path, located);
    } else {
        out = dg_text.render(heap, out, ds, path, source, located);
    }
    borrow out as &o in {
        buffer.write(io, o);
    }
    buffer.drop(heap, out);
    return diag_status(ds);
}

// The exit status the diagnostics `ds` give: 1 if any is an error, 2 if one is internal.
fn diag_status[&q](ds: &q dg.Diags) -> [] int {
    var status = 0;
    if dg.count_errors(ds) > 0 {
        status = 1;
    }
    var k = 0;
    while k < dg.size(ds) {
        if dg.is_internal(dg.get(ds, k).rule) && dg.get(ds, k).kids.nest == 0 {
            status = 2;
        }
        k = k + 1;
    }
    return status;
}

// `chw check FILE --ran`: the names of the rule groups the checker ran, one per line, in the order Python's
// `sorted(ran)` gives (docs/cancho-port.md, 32). The bits are those of `chw.check.ran`.
fn show_ran[&h, &i](heap: &!h Heap, io: &!i Io, mask: int) -> [heap, io_write] int {
    var out = buffer.empty(heap, 64);
    if mask / 2 % 2 == 1 {
        out = buffer.append(heap, out, "block\n");
    }
    if mask / 16 % 2 == 1 {
        out = buffer.append(heap, out, "dma\n");
    }
    if mask / 8 % 2 == 1 {
        out = buffer.append(heap, out, "interrupts\n");
    }
    if mask / 4 % 2 == 1 {
        out = buffer.append(heap, out, "registers\n");
    }
    if mask % 2 == 1 {
        out = buffer.append(heap, out, "schema-version\n");
    }
    borrow out as &o in {
        buffer.write(io, o);
    }
    buffer.drop(heap, out);
    return 0;
}

// Print the refusals of `doc`; the answer is the exit status.
fn show_refusals[&h, &i, &r, &p](heap: &!h Heap, io: &!i Io, report: &r [byte], path: &p [byte], machine: bool, to_stdout: bool) -> [heap, io_write, err_write] int {
    var out = buffer.empty(heap, 256);
    var status = 0;
    if diag.count(report) > 0 {
        status = 1;
        var from = 0;
        while from < len(report) {
            let e = diag.end_of(report, from);
            if bytes.equal(diag.code(report[from..e]), "internal") {
                status = 2;
            }
            from = e + 1;
        }
    }
    if machine {
        out = buffer.append(heap, out, report);
    } else {
        out = diag.render_all(heap, out, report, path);
    }
    borrow out as &o in {
        if to_stdout {
            buffer.write(io, o);
        } else {
            console.error_all(io, buffer.bytes(o));
        }
    }
    buffer.drop(heap, out);
    return status;
}

fn run_parse[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    let (text, got) = chwio.read_file(heap, fs, arg(g, 2), buffer.empty(heap, 4096));
    var status = 2;
    if got < 0 {
        console.error_all(io, "cannot read file\n");
    } else {
        let none = load.open_schema(heap, buffer.empty(heap, 1));
        borrow text as &t in {
            borrow none as &s in {
                let doc = load.load(heap, buffer.bytes(t), s);
                borrow doc as &dr in {
                    if diag.count(load.report(dr)) > 0 {
                        status = show_refusals(heap, io, load.report(dr), arg(g, 2), false, false);
                    } else {
                        status = 0;
                        let out = load.render_ir(heap, dr);
                        borrow out as &o in {
                            buffer.write(io, o);
                        }
                        buffer.drop(heap, out);
                    }
                }
                load.drop(heap, doc);
            }
        }
        load.drop_schema(heap, none);
    }
    buffer.drop(heap, text);
    return status;
}

fn run_validate[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var status = 2;
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        let (text, got) = chwio.read_file(heap, fs, arg(g, 2), buffer.empty(heap, 4096));
        if got < 0 {
            console.error_all(io, "cannot read file\n");
        } else {
            borrow text as &t in {
                borrow sch as &s in {
                    let doc = load.load(heap, buffer.bytes(t), s);
                    borrow doc as &dr in {
                        if output_is_json(g) && flag_at(g, "--machine") < 0 {
                            let structural = load.structural(heap, dr);
                            borrow structural as &sd in {
                                status = show_diags(heap, io, sd, arg(g, 2), buffer.bytes(t), true, flag_at(g, "--located") > 0);
                            }
                            dg.drop(heap, structural);
                        } else {
                            status = show_refusals(heap, io, load.report(dr), arg(g, 2), flag_at(g, "--machine") > 0, true);
                        }
                    }
                    load.drop(heap, doc);
                }
            }
        }
        buffer.drop(heap, text);
    }
    load.drop_schema(heap, sch);
    return status;
}

fn run_check[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var status = 2;
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        let (text, got) = chwio.read_file(heap, fs, arg(g, 2), buffer.empty(heap, 4096));
        if got < 0 {
            console.error_all(io, "cannot read file\n");
        } else {
            borrow text as &t in {
                borrow sch as &s in {
                    let doc = load.load(heap, buffer.bytes(t), s);
                    borrow doc as &dr in {
                        if flag_at(g, "--ran") > 0 {
                            show_ran(heap, io, load.ran(dr));
                            status = diag_status(load.diags(dr));
                        } else {
                            status = show_diags(heap, io, load.diags(dr), arg(g, 2), buffer.bytes(t), output_is_json(g), flag_at(g, "--located") > 0);
                        }
                    }
                    load.drop(heap, doc);
                }
            }
        }
        buffer.drop(heap, text);
    }
    load.drop_schema(heap, sch);
    return status;
}

fn flag_value[&g](g: &g Args, name: &static [byte]) -> [args] int {
    let at = flag_at(g, name);
    if at > 0 && at + 1 < arg_count(g) {
        return at + 1;
    }
    return 0 - 1;
}

// Write the report `built` (the compact text `report.build` wrote) as asked, after it has refused itself or not; the
// answer is the exit status.
fn emit_report[&h, &i, &b](heap: &!h Heap, io: &!i Io, built: &b [byte], as_text: bool, pretty: bool, strict: bool) -> [heap, io_write, err_write] int {
    let (tape, nodes) = tape_of(heap, built);
    var status = 0;
    if nodes < 0 {
        status = internal_error(io, "error[internal]: the report printed as invalid JSON\n");
    } else {
        borrow tape as &tr in {
            let refusals = report_check.validate(heap, buffer.empty(heap, 128), built, contents(tr));
            var refused_n = 0;
            borrow refusals as &rf in {
                refused_n = len(buffer.bytes(rf));
                if refused_n > 0 {
                    console.error_all(io, buffer.bytes(rf));
                }
            }
            if refused_n > 0 {
                status = 1;
            } else {
                var out = buffer.empty(heap, 4096);
                if as_text {
                    out = report.text(heap, out, built, contents(tr));
                } else if pretty {
                    out = buffer.push(heap, diff_fmt.pretty(heap, out, built, contents(tr), 0, 0), byte_of('\n'));
                } else {
                    out = buffer.push(heap, buffer.append(heap, out, built), byte_of('\n'));
                }
                borrow out as &o in {
                    buffer.write(io, o);
                }
                buffer.drop(heap, out);
                if strict && !report.strict_ok(built, contents(tr)) {
                    status = 1;
                }
            }
            buffer.drop(heap, refusals);
        }
    }
    unbox_slice(heap, tape);
    return status;
}

fn lanes_refused[&i, &r](io: &!i Io, reason: &r [byte]) -> [err_write] int {
    console.error_all(io, "error[lanes-invalid]: ");
    console.error_all(io, reason);
    console.error_all(io, "\n");
    return 1;
}

// `chw report FILE ...`: the contract is loaded and checked, then described. `lanes` is the oracle's results, or `[]`.
fn report_file[&h, &i, &f, &g, &t](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args, sch: &t load.Schema) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    var as_text = false;
    let out_at = flag_value(g, "--output");
    if out_at > 0 {
        as_text = bytes.equal(arg(g, out_at), "text");
    }
    var mode = 0;
    var lanes = buffer.append(heap, buffer.empty(heap, 16), "[]");
    var lanes_ok = true;
    var status = 0;
    let lane_at = flag_value(g, "--lanes");
    if flag_at(g, "--no-roundtrips") > 0 {
        mode = 2;
    } else if lane_at > 0 {
        mode = 1;
        let (ltext, lgot) = chwio.read_file(heap, fs, arg(g, lane_at), buffer.empty(heap, 1024));
        buffer.drop(heap, lanes);
        lanes = ltext;
        if lgot < 0 {
            lanes_ok = false;
            status = lanes_refused(io, "the lanes file cannot be read");
        }
    }
    var ltape = box_slice(heap, 0, 0);
    var lnodes = 0;
    borrow lanes as &lr in {
        unbox_slice(heap, ltape);
        let (lt0, ln0) = tape_of(heap, buffer.bytes(lr));
        ltape = lt0;
        lnodes = ln0;
    }
    if lanes_ok && mode == 1 {
        if lnodes < 0 {
            lanes_ok = false;
            status = lanes_refused(io, "the lanes file is not JSON");
        } else {
            borrow lanes as &lr in {
                borrow ltape as &lt in {
                    let why = report.lanes_check(buffer.bytes(lr), contents(lt));
                    if why != 0 {
                        lanes_ok = false;
                        status = lanes_refused(io, report.lanes_reason(why));
                    }
                }
            }
        }
    }
    if lanes_ok {
        let (text, got) = chwio.read_file(heap, fs, arg(g, 2), buffer.empty(heap, 4096));
        if got < 0 {
            console.error_all(io, "cannot read file\n");
            status = 2;
        } else {
            borrow text as &t2 in {
                let doc = load.load(heap, buffer.bytes(t2), sch);
                borrow doc as &dr in {
                    var built = buffer.empty(heap, 1);
                    borrow lanes as &lr in {
                        borrow ltape as &lt in {
                            buffer.drop(heap, built);
                            built = report.build(heap, dr, arg(g, 2), buffer.bytes(t2), mode, buffer.bytes(lr), contents(lt));
                        }
                    }
                    borrow built as &br in {
                        status = emit_report(heap, io, buffer.bytes(br), as_text, flag_at(g, "--pretty") > 0, flag_at(g, "--strict") > 0);
                    }
                    buffer.drop(heap, built);
                }
                load.drop(heap, doc);
            }
        }
        buffer.drop(heap, text);
    }
    unbox_slice(heap, ltape);
    buffer.drop(heap, lanes);
    return status;
}

// `chw report --validate DOC`: the refusals of `validate_report` on the report in DOC.
fn report_validate[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, err_write, fs_read(""), file_read, args] int {
    if arg_count(g) < 4 {
        return usage(io);
    }
    let (text, got) = chwio.read_file(heap, fs, arg(g, 3), buffer.empty(heap, 4096));
    var status = 0;
    if got < 0 {
        console.error_all(io, "cannot read file\n");
        status = 2;
    } else {
        borrow text as &t2 in {
            let (tape, nodes) = tape_of(heap, buffer.bytes(t2));
            if nodes < 0 {
                console.error_all(io, "error[report-unreadable]: the report is not JSON\n");
                status = 1;
            } else {
                borrow tape as &tr in {
                    let refusals = report_check.validate(heap, buffer.empty(heap, 128), buffer.bytes(t2), contents(tr));
                    borrow refusals as &rf in {
                        if len(buffer.bytes(rf)) > 0 {
                            console.error_all(io, buffer.bytes(rf));
                            status = 1;
                        }
                    }
                    buffer.drop(heap, refusals);
                }
            }
            unbox_slice(heap, tape);
        }
    }
    buffer.drop(heap, text);
    return status;
}

fn run_report[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    if bytes.equal(arg(g, 2), "--validate") {
        return report_validate(heap, io, fs, g);
    }
    let out_at = flag_value(g, "--output");
    if out_at > 0 && !bytes.equal(arg(g, out_at), "json") && !bytes.equal(arg(g, out_at), "text") {
        return usage(io);
    }
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var status = 2;
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        borrow sch as &s in {
            status = report_file(heap, io, fs, g, s);
        }
    }
    load.drop_schema(heap, sch);
    return status;
}

// The `n`th (from 0) argument after the verb that is neither a flag nor a flag's value, or -1.
fn nth_file[&g](g: &g Args, n: int) -> [args] int {
    var i = 2;
    var seen = 0;
    while i < arg_count(g) {
        if bytes.equal(arg(g, i), "--schema") {
            i = i + 2;
        } else if bytes.equal(arg(g, i), "--pretty") {
            i = i + 1;
        } else {
            if seen == n {
                return i;
            }
            seen = seen + 1;
            i = i + 1;
        }
    }
    return 0 - 1;
}

// The tape of `text` and the number of nodes (negative if it is not JSON).
fn tape_of[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (Box[[int]], int) {
    let tape = box_slice(heap, json.tape_len(text), 0);
    var nodes = 0;
    borrow mut tape as &!w in {
        nodes = json.parse(text, contents(w));
    }
    return (tape, nodes);
}

// Print the refusals of `doc` (what `_load_or_refuse` does): true if it was refused.
fn refused[&h, &i, &q](heap: &!h Heap, io: &!i Io, doc: &q load.Doc) -> [heap, err_write] bool {
    let ds = load.diags(doc);
    if !load.loaded(doc) || dg.count_errors(ds) > 0 {
        print_errors(heap, io, ds);
        return true;
    }
    return false;
}

fn internal_error[&i](io: &!i Io, what: &static [byte]) -> [err_write] int {
    console.error_all(io, what);
    return 2;
}

// The JSON a diff reads for `doc`, and whether it is the file as written: a file in the JSON wire form is read as it
// is (Python's dict is the file, in its key order and spelling), a text-form file as the JSON its IR prints as.
fn canonical[&h, &q, &o](heap: &!h Heap, doc: &q load.Doc, original: &o [byte]) -> [heap] (buffer.Buffer, bool) {
    if load.is_json_form(original) {
        return (buffer.append(heap, buffer.empty(heap, 1024), original), true);
    }
    return (load.render_ir(heap, doc), false);
}

fn unsupported[&i](io: &!i Io, which: &static [byte]) -> [err_write] int {
    console.error_all(io, "error[diff-text-unsupported]: the ");
    console.error_all(io, which);
    console.error_all(io, " contract has a string with an escape or a byte that is not printable ASCII, or a number that is not a plain integer; the port does not write what Python decodes (docs/cancho-port.md, 33.3)\n");
    return 1;
}

// The text of the §7 document (impact: the §7.1 document) of two loaded, checked contracts, or the status and the
// message on standard error.
fn diff_text[&h, &i, &b, &c, &x, &y](heap: &!h Heap, io: &!i Io, base: &b load.Doc, bfile: &x [byte], cand: &c load.Doc, cfile: &y [byte], as_impact: bool, pretty: bool) -> [heap, io_write, err_write] int {
    let (brender, braw) = canonical(heap, base, bfile);
    let (crender, craw) = canonical(heap, cand, cfile);
    var status = 0;
    borrow brender as &br in {
        borrow crender as &cr in {
            let (btape, bnodes) = tape_of(heap, buffer.bytes(br));
            let (ctape, cnodes) = tape_of(heap, buffer.bytes(cr));
            if bnodes < 0 || cnodes < 0 {
                status = internal_error(io, "error[internal]: the IR printed as invalid JSON\n");
            } else {
                var plain_b = true;
                var plain_c = true;
                borrow btape as &bq in {
                    plain_b = !braw || du.plain_json(buffer.bytes(br), contents(bq), bnodes);
                }
                borrow ctape as &cq in {
                    plain_c = !craw || du.plain_json(buffer.bytes(cr), contents(cq), cnodes);
                }
                if !plain_b {
                    status = unsupported(io, "base");
                } else if !plain_c {
                    status = unsupported(io, "candidate");
                } else {
                    borrow btape as &bt in {
                        borrow ctape as &ct in {
                            let doc = diff.document(heap, buffer.empty(heap, 1024), buffer.bytes(br), contents(bt), buffer.bytes(cr), contents(ct));
                            var out = buffer.empty(heap, 1);
                            if as_impact {
                                var whole = buffer.empty(heap, 1);
                                var arts = buffer.empty(heap, 256);
                                var astatus = 0;
                                var atarget = 0;
                                borrow doc as &dr in {
                                    let (dtape, dnodes) = tape_of(heap, buffer.bytes(dr));
                                    borrow dtape as &dt in {
                                        let (a, st, which) = impact.artifacts(heap, buffer.empty(heap, 256), buffer.bytes(dr), contents(dt), load.source_of(base), load.ir_of(base), load.source_of(cand), load.ir_of(cand));
                                        buffer.drop(heap, arts);
                                        arts = a;
                                        astatus = st;
                                        atarget = which;
                                    }
                                    unbox_slice(heap, dtape);
                                    buffer.drop(heap, whole);
                                    whole = buffer.append(heap, buffer.empty(heap, 1024), "{\"schema\": \"cancho-hdl-impact\", \"version\": \"0.1.0\", \"diff\": ");
                                    whole = buffer.append(heap, whole, buffer.bytes(dr));
                                    whole = buffer.append(heap, whole, ", \"affected_artifacts\": [");
                                }
                                buffer.drop(heap, doc);
                                if astatus != 0 {
                                    var line = buffer.empty(heap, 128);
                                    if astatus == 1 {
                                        line = buffer.append(heap, line, "error[generator-unimplemented]: target ");
                                        line = buffer.append(heap, line, impact.target(atarget));
                                        line = buffer.append(heap, line, ": ");
                                    } else {
                                        line = buffer.append(heap, line, "error[internal]: ");
                                    }
                                    borrow arts as &ar in {
                                        line = buffer.append(heap, line, buffer.bytes(ar));
                                    }
                                    line = buffer.push(heap, line, byte_of('\n'));
                                    borrow line as &lr in {
                                        console.error_all(io, buffer.bytes(lr));
                                    }
                                    buffer.drop(heap, line);
                                    status = astatus;
                                } else {
                                    borrow arts as &ar in {
                                        whole = buffer.append(heap, whole, buffer.bytes(ar));
                                    }
                                    whole = buffer.append(heap, whole, "]}");
                                }
                                buffer.drop(heap, arts);
                                buffer.drop(heap, out);
                                out = whole;
                            } else {
                                buffer.drop(heap, out);
                                out = doc;
                            }
                            if status == 0 {
                                if pretty {
                                    var shown = buffer.empty(heap, 1);
                                    borrow out as &outr in {
                                        let (otape, onodes) = tape_of(heap, buffer.bytes(outr));
                                        borrow otape as &ot in {
                                            buffer.drop(heap, shown);
                                            shown = diff_fmt.pretty(heap, buffer.empty(heap, 1024), buffer.bytes(outr), contents(ot), 0, 0);
                                        }
                                        unbox_slice(heap, otape);
                                    }
                                    buffer.drop(heap, out);
                                    out = shown;
                                }
                                out = buffer.push(heap, out, byte_of('\n'));
                                borrow out as &outr in {
                                    buffer.write(io, outr);
                                }
                            }
                            buffer.drop(heap, out);
                        }
                    }
                }
            }
            unbox_slice(heap, btape);
            unbox_slice(heap, ctape);
        }
    }
    buffer.drop(heap, brender);
    buffer.drop(heap, crender);
    return status;
}

// `chw diff BASE CANDIDATE [--pretty]` and `chw impact ...` (oracle/legacy/tools/diff/diff.py): exit 1 if a contract is refused.
fn run_diff[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args, as_impact: bool) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    if nth_file(g, 1) < 0 || nth_file(g, 2) >= 0 {
        return usage(io);
    }
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var status = 2;
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        let (btext, bgot) = chwio.read_file(heap, fs, arg(g, nth_file(g, 0)), buffer.empty(heap, 4096));
        let (ctext, cgot) = chwio.read_file(heap, fs, arg(g, nth_file(g, 1)), buffer.empty(heap, 4096));
        if bgot < 0 || cgot < 0 {
            console.error_all(io, "cannot read file\n");
        } else {
            borrow btext as &bt in {
                borrow ctext as &ct in {
                    borrow sch as &s in {
                        let base = load.load(heap, buffer.bytes(bt), s);
                        let cand = load.load(heap, buffer.bytes(ct), s);
                        borrow base as &br in {
                            borrow cand as &cr in {
                                let rb = refused(heap, io, br);
                                let rc = refused(heap, io, cr);
                                if rb || rc {
                                    status = 1;
                                } else {
                                    status = diff_text(heap, io, br, buffer.bytes(bt), cr, buffer.bytes(ct), as_impact, flag_at(g, "--pretty") > 0);
                                }
                            }
                        }
                        load.drop(heap, base);
                        load.drop(heap, cand);
                    }
                }
            }
        }
        buffer.drop(heap, btext);
        buffer.drop(heap, ctext);
    }
    load.drop_schema(heap, sch);
    return status;
}

// `error[CODE]: MESSAGE` for the top-level diagnostics of `ds` that `only_errors` selects, on standard error.
fn print_errors[&h, &i, &q](heap: &!h Heap, io: &!i Io, ds: &q dg.Diags) -> [heap, err_write] int {
    var k = 0;
    while k < dg.size(ds) {
        let d = dg.get(ds, k);
        if d.kids.nest == 0 && dg.is_error(d.rule) {
            var line = buffer.append(heap, buffer.empty(heap, 96), "error[");
            line = buffer.append(heap, line, dg.rule_name(d.rule));
            line = buffer.append(heap, line, "]: ");
            line = buffer.append(heap, line, dg.text(ds, d.msg));
            line = buffer.push(heap, line, byte_of('\n'));
            borrow line as &lr in {
                console.error_all(io, buffer.bytes(lr));
            }
            buffer.drop(heap, line);
        }
        k = k + 1;
    }
    return 0;
}

// The value of `--target`, or empty when it is absent; the FILE is the first argument after the verb that is
// neither a flag nor a flag's value.
fn target_of[&g](g: &g Args) -> [args] &g [byte] {
    let at = flag_at(g, "--target");
    if at > 0 && at + 1 < arg_count(g) {
        return arg(g, at + 1);
    }
    return arg(g, 0)[0..0];
}

fn file_arg[&g](g: &g Args) -> [args] int {
    var i = 2;
    while i < arg_count(g) {
        if bytes.equal(arg(g, i), "--target") || bytes.equal(arg(g, i), "--schema") {
            i = i + 2;
        } else {
            return i;
        }
    }
    return 0 - 1;
}

fn known_target[&t](target: &t [byte]) -> [] bool {
    return bytes.equal(target, "c-header") || bytes.equal(target, "cancho-binding") || bytes.equal(target, "devicetree") || bytes.equal(target, "svd") || bytes.equal(target, "systemverilog");
}

fn run_generate_doc[&h, &i, &q, &g](heap: &!h Heap, io: &!i Io, doc: &q load.Doc, g: &g Args) -> [heap, io_write, err_write, args] int {
    let ds = load.diags(doc);
    if !load.loaded(doc) {
        print_errors(heap, io, ds);
        return 1;
    }
    if dg.count_errors(ds) > 0 {
        print_errors(heap, io, ds);
        console.error_all(io, "error: not generating from a refused contract.\n");
        return 1;
    }
    let target = target_of(g);
    if !known_target(target) {
        var line = buffer.append(heap, buffer.empty(heap, 128), "error[generator-target-unknown]: target ");
        line = pyrepr.str_repr(heap, line, target);
        line = buffer.append(heap, line, " is not supported. Known: c-header, cancho-binding, devicetree, svd, systemverilog\n");
        borrow line as &lr in {
            console.error_all(io, buffer.bytes(lr));
        }
        buffer.drop(heap, line);
        return 1;
    }
    let is_c = bytes.equal(target, "c-header");
    let is_svd = bytes.equal(target, "svd");
    let is_binding = bytes.equal(target, "cancho-binding");
    let is_sv = bytes.equal(target, "systemverilog");
    if !is_c && !is_svd && !is_binding && !is_sv && !bytes.equal(target, "devicetree") {
        var line = buffer.append(heap, buffer.empty(heap, 128), "error[generator-unimplemented]: target ");
        line = buffer.append(heap, line, target);
        line = buffer.append(heap, line, ": not ported to cancho yet (the Python tool has it)\n");
        borrow line as &lr in {
            console.error_all(io, buffer.bytes(lr));
        }
        buffer.drop(heap, line);
        return 1;
    }
    var text = buffer.empty(heap, 1);
    var status = 0;
    if is_c {
        let (t, st) = gen_c.generate(heap, load.source_of(doc), arg(g, file_arg(g)), load.ir_of(doc));
        buffer.drop(heap, text);
        text = t;
        status = st;
    } else if is_sv {
        let (t, st) = gen_sv.generate(heap, load.source_of(doc), arg(g, file_arg(g)), load.ir_of(doc));
        buffer.drop(heap, text);
        text = t;
        status = st;
    } else if is_binding {
        let (t, st) = gen_binding.generate(heap, load.source_of(doc), arg(g, file_arg(g)), load.ir_of(doc));
        buffer.drop(heap, text);
        text = t;
        status = st;
    } else if is_svd {
        let (t, st) = gen_svd.generate(heap, load.source_of(doc), arg(g, file_arg(g)), load.ir_of(doc));
        buffer.drop(heap, text);
        text = t;
        status = st;
    } else {
        let (t, st) = gen_dts.generate(heap, load.source_of(doc), arg(g, file_arg(g)), load.ir_of(doc));
        buffer.drop(heap, text);
        text = t;
        status = st;
    }
    if status == 0 {
        borrow text as &tr in {
            buffer.write(io, tr);
        }
    } else {
        var line = buffer.empty(heap, 128);
        if status == 1 {
            line = buffer.append(heap, line, "error[generator-unimplemented]: target ");
            line = buffer.append(heap, line, target);
            line = buffer.append(heap, line, ": ");
        } else {
            line = buffer.append(heap, line, "error[internal]: ");
        }
        borrow text as &tr in {
            line = buffer.append(heap, line, buffer.bytes(tr));
        }
        line = buffer.push(heap, line, byte_of('\n'));
        borrow line as &lr in {
            console.error_all(io, buffer.bytes(lr));
        }
        buffer.drop(heap, line);
    }
    buffer.drop(heap, text);
    return status;
}

fn run_generate[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    if flag_at(g, "--target") < 0 || len(target_of(g)) == 0 || file_arg(g) < 0 {
        return usage(io);
    }
    var status = 2;
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        let (text, got) = chwio.read_file(heap, fs, arg(g, file_arg(g)), buffer.empty(heap, 4096));
        if got < 0 {
            var line = buffer.append(heap, buffer.empty(heap, 64), "error: file not found: ");
            line = buffer.append(heap, line, arg(g, file_arg(g)));
            line = buffer.push(heap, line, byte_of('\n'));
            borrow line as &lr in {
                console.error_all(io, buffer.bytes(lr));
            }
            buffer.drop(heap, line);
        } else {
            borrow text as &t in {
                borrow sch as &s in {
                    let doc = load.load(heap, buffer.bytes(t), s);
                    borrow doc as &dr in {
                        status = run_generate_doc(heap, io, dr, g);
                    }
                    load.drop(heap, doc);
                }
            }
        }
        buffer.drop(heap, text);
    }
    load.drop_schema(heap, sch);
    return status;
}

// `chw catalog`: every rule with the subject, severity and tier the code gives
// it, one per line, tab-separated (checked against the spec by
// tests/differential/catalog.py).
fn run_catalog[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_write] int {
    var out = buffer.empty(heap, 1024);
    var k = 0;
    while k < dg.rule_count() {
        let r = dg.rule_at(k);
        out = buffer.append(heap, out, dg.rule_name(r));
        out = buffer.push(heap, out, byte_of('\t'));
        out = buffer.append(heap, out, dg.kind_name(dg.rule_kind(r)));
        out = buffer.push(heap, out, byte_of('\t'));
        out = buffer.append(heap, out, dg.severity_name(dg.rule_severity(r)));
        out = buffer.push(heap, out, byte_of('\t'));
        out = buffer.append(heap, out, dg.tier_name(dg.rule_tier(r)));
        out = buffer.push(heap, out, byte_of('\n'));
        k = k + 1;
    }
    borrow out as &o in {
        buffer.write(io, o);
    }
    buffer.drop(heap, out);
    return 0;
}

fn run_conform[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), dir_read, file_read, args] int {
    var root = ".";
    if arg_count(g) > 2 && !bytes.starts_with(arg(g, 2), "--") {
        root = arg(g, 2);
    }
    var extra = "";
    let at = flag_at(g, "--fixtures");
    if at > 0 && at + 1 < arg_count(g) {
        extra = arg(g, at + 1);
    }
    var status = 2;
    match open_dir(fs, root) {
        DirOpened::Ok(opened) => {
            var dir = opened;
            borrow dir as &d in {
                let (stext, sgot) = chwio.read_in(heap, d, "spec/contract-schema/cancho-hdl-contract.schema.json", buffer.empty(heap, 8192));
                let sch = load.open_schema(heap, stext);
                var usable = false;
                borrow sch as &sr in {
                    usable = load.schema_ok(sr);
                }
                if sgot < 0 || !usable {
                    console.error_all(io, "cannot read spec/contract-schema/cancho-hdl-contract.schema.json beneath the root, or it is not JSON\n");
                } else {
                    borrow sch as &s in {
                        status = conform.run(heap, io, d, s, extra);
                    }
                }
                load.drop_schema(heap, sch);
            }
            dir_close(dir);
        }
        DirOpened::Failed(reason) => {
            console.error_all(io, "cannot open the root directory\n");
        }
    }
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals } = split(world);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    var status = 2;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &g in {
                borrow fs as &f in {
                    if arg_count(g) < 2 {
                        status = usage(i);
                    } else if bytes.equal(arg(g, 1), "parse") && arg_count(g) >= 3 {
                        status = run_parse(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "validate") && arg_count(g) >= 3 {
                        status = run_validate(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "check") && arg_count(g) >= 3 {
                        status = run_check(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "generate") && arg_count(g) >= 3 {
                        status = run_generate(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "diff") && arg_count(g) >= 4 {
                        status = run_diff(h, i, f, g, false);
                    } else if bytes.equal(arg(g, 1), "impact") && arg_count(g) >= 4 {
                        status = run_diff(h, i, f, g, true);
                    } else if bytes.equal(arg(g, 1), "report") && arg_count(g) >= 3 {
                        status = run_report(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "catalog") {
                        status = run_catalog(h, i);
                    } else if bytes.equal(arg(g, 1), "conform") {
                        status = run_conform(h, i, f, g);
                    } else {
                        status = usage(i);
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    return status;
}
