edition 6;

// main.cho -- the `chw` command line (docs/cancho-port.md, 9.2).
//
//     chw parse FILE                  load FILE (text or JSON form), print the IR as one
//                                     line of JSON; no schema check (parser.py FILE)
//     chw validate FILE [--schema S] [--machine] [--output json] [--located]
//                                     load and validate against the schema S (default
//                                     spec/contract-schema/cancho-hdl-contract.schema.json),
//                                     print every refusal
//     chw check FILE [--schema S] [--output text|json] [--located]
//                                     validate, then run every semantic rule (checker.py FILE):
//                                     the text form, or the JSON of `--output json`, which is
//                                     the Python checker's byte for byte (--located adds the
//                                     position of the node a structural refusal names)
//     chw generate FILE --target T [--schema S]
//                                     the artifact of target T for a contract the checker accepts
//                                     (tools/generate/generate.py): c-header and devicetree are ported
//     chw catalog                     every rule with its subject, severity and tier
//     chw conform [ROOT] [--fixtures DIR[,DIR...]]
//                                     run the examples and the refusal fixtures under ROOT
//                                     (default .) through the loader, validator and checker
//
// Exit 0 clean, 1 something was refused or mismatched, 2 usage or the tool itself could
// not run (an unreadable file or schema, a schema keyword this validator lacks).

import std.buffer;
import std.bytes;
import std.io as console;
import chw.conform;
import chw.dg_json;
import chw.dg_text;
import chw.diag;
import chw.diagnostic as dg;
import chw.gen_c;
import chw.gen_dts;
import chw.io as chwio;
import chw.load;
import chw.pyrepr;

fn usage[&i](io: &!i Io) -> [err_write] int {
    console.error_all(io, "usage: chw parse FILE | chw validate FILE [--schema S] [--machine] [--output json] [--located] | chw check FILE [--schema S] [--output text|json] [--located] | chw generate FILE --target T [--schema S] | chw catalog | chw conform [ROOT] [--fixtures DIR[,DIR...]]\n");
    return 2;
}

// The index of the flag `name` among the arguments, or -1.
fn flag_at[&g](g: &g Args, name: &static [byte]) -> [args] int {
    var i = 1;
    while i < arg_count(g) {
        if bytes.equal(arg(g, i), name) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn schema_path[&g](g: &g Args) -> [args] &g [byte] {
    let at = flag_at(g, "--schema");
    if at > 0 && at + 1 < arg_count(g) {
        return arg(g, at + 1);
    }
    return "spec/contract-schema/cancho-hdl-contract.schema.json";
}

fn output_is_json[&g](g: &g Args) -> [args] bool {
    let at = flag_at(g, "--output");
    return at > 0 && at + 1 < arg_count(g) && bytes.equal(arg(g, at + 1), "json");
}

// Print the diagnostics `ds` of the file `path` (whose text is `source`) as
// JSON or as text, to standard output; the answer is the exit status: 1 if any
// is an Error, 2 if any is the tool's own fault, else 0.
fn show_diags[&h, &i, &q, &p, &s](heap: &!h Heap, io: &!i Io, ds: &q dg.Diags, path: &p [byte], source: &s [byte], as_json: bool, located: bool) -> [heap, io_write] int {
    var out = buffer.empty(heap, 256);
    if as_json {
        out = dg_json.render(heap, out, ds, path, located);
    } else {
        out = dg_text.render(heap, out, ds, path, source, located);
    }
    borrow out as &o in {
        buffer.write(io, o);
    }
    buffer.drop(heap, out);
    var status = 0;
    if dg.count_errors(ds) > 0 {
        status = 1;
    }
    var k = 0;
    while k < dg.size(ds) {
        if dg.is_internal(dg.get(ds, k).rule) && dg.get(ds, k).kids.nest == 0 {
            status = 2;
        }
        k = k + 1;
    }
    return status;
}

// Print the refusals of `doc`; the answer is the exit status.
fn show_refusals[&h, &i, &r, &p](heap: &!h Heap, io: &!i Io, report: &r [byte], path: &p [byte], machine: bool, to_stdout: bool) -> [heap, io_write, err_write] int {
    var out = buffer.empty(heap, 256);
    var status = 0;
    if diag.count(report) > 0 {
        status = 1;
        var from = 0;
        while from < len(report) {
            let e = diag.end_of(report, from);
            if bytes.equal(diag.code(report[from..e]), "internal") {
                status = 2;
            }
            from = e + 1;
        }
    }
    if machine {
        out = buffer.append(heap, out, report);
    } else {
        out = diag.render_all(heap, out, report, path);
    }
    borrow out as &o in {
        if to_stdout {
            buffer.write(io, o);
        } else {
            console.error_all(io, buffer.bytes(o));
        }
    }
    buffer.drop(heap, out);
    return status;
}

fn run_parse[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    let (text, got) = chwio.read_file(heap, fs, arg(g, 2), buffer.empty(heap, 4096));
    var status = 2;
    if got < 0 {
        console.error_all(io, "cannot read file\n");
    } else {
        let none = load.open_schema(heap, buffer.empty(heap, 1));
        borrow text as &t in {
            borrow none as &s in {
                let doc = load.load(heap, buffer.bytes(t), s);
                borrow doc as &dr in {
                    if diag.count(load.report(dr)) > 0 {
                        status = show_refusals(heap, io, load.report(dr), arg(g, 2), false, false);
                    } else {
                        status = 0;
                        let out = load.render_ir(heap, dr);
                        borrow out as &o in {
                            buffer.write(io, o);
                        }
                        buffer.drop(heap, out);
                    }
                }
                load.drop(heap, doc);
            }
        }
        load.drop_schema(heap, none);
    }
    buffer.drop(heap, text);
    return status;
}

fn run_validate[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var status = 2;
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        let (text, got) = chwio.read_file(heap, fs, arg(g, 2), buffer.empty(heap, 4096));
        if got < 0 {
            console.error_all(io, "cannot read file\n");
        } else {
            borrow text as &t in {
                borrow sch as &s in {
                    let doc = load.load(heap, buffer.bytes(t), s);
                    borrow doc as &dr in {
                        if output_is_json(g) && flag_at(g, "--machine") < 0 {
                            let structural = load.structural(heap, dr);
                            borrow structural as &sd in {
                                status = show_diags(heap, io, sd, arg(g, 2), buffer.bytes(t), true, flag_at(g, "--located") > 0);
                            }
                            dg.drop(heap, structural);
                        } else {
                            status = show_refusals(heap, io, load.report(dr), arg(g, 2), flag_at(g, "--machine") > 0, true);
                        }
                    }
                    load.drop(heap, doc);
                }
            }
        }
        buffer.drop(heap, text);
    }
    load.drop_schema(heap, sch);
    return status;
}

fn run_check[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var status = 2;
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        let (text, got) = chwio.read_file(heap, fs, arg(g, 2), buffer.empty(heap, 4096));
        if got < 0 {
            console.error_all(io, "cannot read file\n");
        } else {
            borrow text as &t in {
                borrow sch as &s in {
                    let doc = load.load(heap, buffer.bytes(t), s);
                    borrow doc as &dr in {
                        status = show_diags(heap, io, load.diags(dr), arg(g, 2), buffer.bytes(t), output_is_json(g), flag_at(g, "--located") > 0);
                    }
                    load.drop(heap, doc);
                }
            }
        }
        buffer.drop(heap, text);
    }
    load.drop_schema(heap, sch);
    return status;
}

// `error[CODE]: MESSAGE` for the top-level diagnostics of `ds` that `only_errors` selects, on standard error.
fn print_errors[&h, &i, &q](heap: &!h Heap, io: &!i Io, ds: &q dg.Diags) -> [heap, err_write] int {
    var k = 0;
    while k < dg.size(ds) {
        let d = dg.get(ds, k);
        if d.kids.nest == 0 && dg.is_error(d.rule) {
            var line = buffer.append(heap, buffer.empty(heap, 96), "error[");
            line = buffer.append(heap, line, dg.rule_name(d.rule));
            line = buffer.append(heap, line, "]: ");
            line = buffer.append(heap, line, dg.text(ds, d.msg));
            line = buffer.push(heap, line, byte_of('\n'));
            borrow line as &lr in {
                console.error_all(io, buffer.bytes(lr));
            }
            buffer.drop(heap, line);
        }
        k = k + 1;
    }
    return 0;
}

// The value of `--target`, or empty when it is absent; the FILE is the first argument after the verb that is
// neither a flag nor a flag's value.
fn target_of[&g](g: &g Args) -> [args] &g [byte] {
    let at = flag_at(g, "--target");
    if at > 0 && at + 1 < arg_count(g) {
        return arg(g, at + 1);
    }
    return arg(g, 0)[0..0];
}

fn file_arg[&g](g: &g Args) -> [args] int {
    var i = 2;
    while i < arg_count(g) {
        if bytes.equal(arg(g, i), "--target") || bytes.equal(arg(g, i), "--schema") {
            i = i + 2;
        } else {
            return i;
        }
    }
    return 0 - 1;
}

fn known_target[&t](target: &t [byte]) -> [] bool {
    return bytes.equal(target, "c-header") || bytes.equal(target, "cancho-binding") || bytes.equal(target, "devicetree") || bytes.equal(target, "svd") || bytes.equal(target, "systemverilog");
}

fn run_generate_doc[&h, &i, &q, &g](heap: &!h Heap, io: &!i Io, doc: &q load.Doc, g: &g Args) -> [heap, io_write, err_write, args] int {
    let ds = load.diags(doc);
    if !load.loaded(doc) {
        print_errors(heap, io, ds);
        return 1;
    }
    if dg.count_errors(ds) > 0 {
        print_errors(heap, io, ds);
        console.error_all(io, "error: not generating from a refused contract.\n");
        return 1;
    }
    let target = target_of(g);
    if !known_target(target) {
        var line = buffer.append(heap, buffer.empty(heap, 128), "error[generator-target-unknown]: target ");
        line = pyrepr.str_repr(heap, line, target);
        line = buffer.append(heap, line, " is not supported. Known: c-header, cancho-binding, devicetree, svd, systemverilog\n");
        borrow line as &lr in {
            console.error_all(io, buffer.bytes(lr));
        }
        buffer.drop(heap, line);
        return 1;
    }
    let is_c = bytes.equal(target, "c-header");
    if !is_c && !bytes.equal(target, "devicetree") {
        var line = buffer.append(heap, buffer.empty(heap, 128), "error[generator-unimplemented]: target ");
        line = buffer.append(heap, line, target);
        line = buffer.append(heap, line, ": not ported to cancho yet (the Python tool has it)\n");
        borrow line as &lr in {
            console.error_all(io, buffer.bytes(lr));
        }
        buffer.drop(heap, line);
        return 1;
    }
    var text = buffer.empty(heap, 1);
    var status = 0;
    if is_c {
        let (t, st) = gen_c.generate(heap, load.source_of(doc), arg(g, file_arg(g)), load.ir_of(doc));
        buffer.drop(heap, text);
        text = t;
        status = st;
    } else {
        let (t, st) = gen_dts.generate(heap, load.source_of(doc), arg(g, file_arg(g)), load.ir_of(doc));
        buffer.drop(heap, text);
        text = t;
        status = st;
    }
    if status == 0 {
        borrow text as &tr in {
            buffer.write(io, tr);
        }
    } else {
        var line = buffer.empty(heap, 128);
        if status == 1 {
            line = buffer.append(heap, line, "error[generator-unimplemented]: target ");
            line = buffer.append(heap, line, target);
            line = buffer.append(heap, line, ": ");
        } else {
            line = buffer.append(heap, line, "error[internal]: ");
        }
        borrow text as &tr in {
            line = buffer.append(heap, line, buffer.bytes(tr));
        }
        line = buffer.push(heap, line, byte_of('\n'));
        borrow line as &lr in {
            console.error_all(io, buffer.bytes(lr));
        }
        buffer.drop(heap, line);
    }
    buffer.drop(heap, text);
    return status;
}

fn run_generate[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), file_read, args] int {
    if flag_at(g, "--target") < 0 || len(target_of(g)) == 0 || file_arg(g) < 0 {
        return usage(io);
    }
    var status = 2;
    let (stext, sgot) = chwio.read_file(heap, fs, schema_path(g), buffer.empty(heap, 8192));
    let sch = load.open_schema(heap, stext);
    var usable = false;
    borrow sch as &sr in {
        usable = load.schema_ok(sr);
    }
    if sgot < 0 || !usable {
        console.error_all(io, "cannot read the schema, or it is not JSON\n");
    } else {
        let (text, got) = chwio.read_file(heap, fs, arg(g, file_arg(g)), buffer.empty(heap, 4096));
        if got < 0 {
            var line = buffer.append(heap, buffer.empty(heap, 64), "error: file not found: ");
            line = buffer.append(heap, line, arg(g, file_arg(g)));
            line = buffer.push(heap, line, byte_of('\n'));
            borrow line as &lr in {
                console.error_all(io, buffer.bytes(lr));
            }
            buffer.drop(heap, line);
        } else {
            borrow text as &t in {
                borrow sch as &s in {
                    let doc = load.load(heap, buffer.bytes(t), s);
                    borrow doc as &dr in {
                        status = run_generate_doc(heap, io, dr, g);
                    }
                    load.drop(heap, doc);
                }
            }
        }
        buffer.drop(heap, text);
    }
    load.drop_schema(heap, sch);
    return status;
}

// `chw catalog`: every rule with the subject, severity and tier the code gives
// it, one per line, tab-separated (checked against the spec by
// tests/differential/catalog.py).
fn run_catalog[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_write] int {
    var out = buffer.empty(heap, 1024);
    var k = 0;
    while k < dg.rule_count() {
        let r = dg.rule_at(k);
        out = buffer.append(heap, out, dg.rule_name(r));
        out = buffer.push(heap, out, byte_of('\t'));
        out = buffer.append(heap, out, dg.kind_name(dg.rule_kind(r)));
        out = buffer.push(heap, out, byte_of('\t'));
        out = buffer.append(heap, out, dg.severity_name(dg.rule_severity(r)));
        out = buffer.push(heap, out, byte_of('\t'));
        out = buffer.append(heap, out, dg.tier_name(dg.rule_tier(r)));
        out = buffer.push(heap, out, byte_of('\n'));
        k = k + 1;
    }
    borrow out as &o in {
        buffer.write(io, o);
    }
    buffer.drop(heap, out);
    return 0;
}

fn run_conform[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_write, err_write, fs_read(""), dir_read, file_read, args] int {
    var root = ".";
    if arg_count(g) > 2 && !bytes.starts_with(arg(g, 2), "--") {
        root = arg(g, 2);
    }
    var extra = "";
    let at = flag_at(g, "--fixtures");
    if at > 0 && at + 1 < arg_count(g) {
        extra = arg(g, at + 1);
    }
    var status = 2;
    match open_dir(fs, root) {
        DirOpened::Ok(opened) => {
            var dir = opened;
            borrow dir as &d in {
                let (stext, sgot) = chwio.read_in(heap, d, "spec/contract-schema/cancho-hdl-contract.schema.json", buffer.empty(heap, 8192));
                let sch = load.open_schema(heap, stext);
                var usable = false;
                borrow sch as &sr in {
                    usable = load.schema_ok(sr);
                }
                if sgot < 0 || !usable {
                    console.error_all(io, "cannot read spec/contract-schema/cancho-hdl-contract.schema.json beneath the root, or it is not JSON\n");
                } else {
                    borrow sch as &s in {
                        status = conform.run(heap, io, d, s, extra);
                    }
                }
                load.drop_schema(heap, sch);
            }
            dir_close(dir);
        }
        DirOpened::Failed(reason) => {
            console.error_all(io, "cannot open the root directory\n");
        }
    }
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals } = split(world);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    var status = 2;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &g in {
                borrow fs as &f in {
                    if arg_count(g) < 2 {
                        status = usage(i);
                    } else if bytes.equal(arg(g, 1), "parse") && arg_count(g) >= 3 {
                        status = run_parse(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "validate") && arg_count(g) >= 3 {
                        status = run_validate(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "check") && arg_count(g) >= 3 {
                        status = run_check(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "generate") && arg_count(g) >= 3 {
                        status = run_generate(h, i, f, g);
                    } else if bytes.equal(arg(g, 1), "catalog") {
                        status = run_catalog(h, i);
                    } else if bytes.equal(arg(g, 1), "conform") {
                        status = run_conform(h, i, f, g);
                    } else {
                        status = usage(i);
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    return status;
}
