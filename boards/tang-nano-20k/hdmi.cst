// The HDMI test pattern (`rtl/top_hdmi.v`). The pins and levels are Sipeed's own constraints for this board
// (TangNano-20K-example/hdmi/src/hdmi.cst); the clock and the LEDs are as in tang_nano_20k.cst.
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "tmds_clk_p" 33;
IO_LOC "tmds_clk_n" 34;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "tmds_clk_n" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[0]" 35;
