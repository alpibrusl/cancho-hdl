edition 8;

import std.io;
import std.buffer;

// memtest.cho -- the 8192-byte RAM of rtl/mem_test.v, judged from cancho three ways:
//   1. the board's own self-test ('b'), five patterns: it must report 0 differing bytes each (it only judges itself);
//   2. after pattern 0 the host reads 64 addresses back and checks them against the pattern, so the self-test is shown to have written;
//   3. 2048 pseudo-random bytes written at pseudo-random distinct addresses by the host, then read back and compared.
// Tty capability only; no foreign call.

fn addr_of(i: int) -> [] int { return (i * 37 + 11) % 8192; }       // 37 is odd: distinct for i < 8192
fn value_of(i: int) -> [] int { return (i * 73 + (i / 7) * 29 + 5) % 256; }

fn xor8(a: int, b: int) -> [] int {
    var r = 0;
    var bit = 1;
    var i = 0;
    while i < 8 {
        let x = (a / bit) % 2;
        let y = (b / bit) % 2;
        if x != y { r = r + bit; }
        bit = bit * 2;
        i = i + 1;
    }
    return r;
}

// the byte the board's pattern 0 stores at address a: a[7:0] xor a[12:8]
fn p0(a: int) -> [] int { return xor8(a % 256, a / 256); }

// send `cmd`, then collect `want` bytes into `out`; answers how many arrived (poller-driven, bounded)
fn exchange[&a, &b, &c, &d](q: &!a Port, pw: &!b Poller, cmd: &c [byte], out: &!d [byte], want: int) -> [tty_write, tty_read, poll] int {
    tty_write(q, cmd);
    var n = 0;
    var tries = 0;
    region r {
        let chunk = alloc_slice[r](16, byte_of(0));
        let ev = alloc_slice[r](2, 0);
        while n < want && tries < 400 {
            poller_wait(pw, ev, 10);
            let k = tty_read(q, chunk);
            var i = 0;
            while i < k && n < want {
                out[n] = chunk[i];
                n = n + 1;
                i = i + 1;
            }
            tries = tries + 1;
        }
    }
    return n;
}

fn say[&h, &i](heap: &!h Heap, io: &!i Io, text: &static [byte], v: int, tail: &static [byte]) -> [heap, io_write] int {
    var line = buffer.empty(heap, 80);
    line = buffer.append(heap, line, text);
    line = buffer.push_nat(heap, line, v);
    line = buffer.append(heap, line, tail);
    line = buffer.push(heap, line, byte_of(10));
    borrow line as &lb in { io.write_all(io, buffer.bytes(lb)); }
    buffer.drop(heap, line);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi); release(fs); release(args); release(net); release(signals); release(exec); release(clock);
    let device = narrow(tty, "/dev");
    var failures = 0;
    var status = 0;
    match poller_new() {
        Polling::Failed(e) => { release(device); release(io); release(heap); return 1; }
        Polling::Ok(open) => {
            var p = open;
            borrow device as &t in {
                match tty_open(t, "/dev/ttyUSB1") {
                    TtyOpened::Failed(errno) => { status = 3; }
                    TtyOpened::Ok(port) => {
                        borrow mut port as &!q in {
                            if tty_configure(q, 115200) != 0 { status = 4; }
                            tty_flush_input(q);
                            borrow mut p as &!pw in { poller_add_tty(pw, q, 1, 1); }
                            borrow mut p as &!pw in {
                                region r {
                                    let c1 = alloc_slice[r](2, byte_of(0));
                                    let c3 = alloc_slice[r](4, byte_of(0));
                                    let ans = alloc_slice[r](4, byte_of(0));
                                    // 1. self-test, five patterns
                                    var pat = 0;
                                    while pat < 5 && status == 0 {
                                        c1[0] = byte_of(98);
                                        c1[1] = byte_of(pat);
                                        let n = exchange(q, pw, c1, ans, 3);
                                        var errs = 1000000;
                                        if n == 3 && int_of(ans[0]) == 66 { errs = int_of(ans[1]) * 256 + int_of(ans[2]); }
                                        borrow mut heap as &!h in { borrow mut io as &!i in { say(h, i, "self-test, differing bytes reported by the board, pattern ", pat, "");
                                        say(h, i, "    differing bytes: ", errs, ""); } }
                                        failures = failures + errs;
                                        pat = pat + 1;
                                    }
                                    // 2. the last pattern run was 4 (zeros); run 0 again and read 64 addresses back
                                    c1[0] = byte_of(98);
                                    c1[1] = byte_of(0);
                                    exchange(q, pw, c1, ans, 3);
                                    var bad2 = 0;
                                    var k = 0;
                                    while k < 64 {
                                        let a = addr_of(k * 3 + 1);
                                        c3[0] = byte_of(114);
                                        c3[1] = byte_of(a / 256);
                                        c3[2] = byte_of(a % 256);
                                        let n = exchange(q, pw, c3, ans, 1);
                                        if n != 1 || int_of(ans[0]) != p0(a) { bad2 = bad2 + 1; }
                                        k = k + 1;
                                    }
                                    borrow mut heap as &!h in { borrow mut io as &!i in { say(h, i, "host read-back of the self-test fill (64 addresses): different ", bad2, ""); } }
                                    failures = failures + bad2;
                                    // 3. host-driven writes and read-back
                                    let w4 = alloc_slice[r](4, byte_of(0));
                                    var j = 0;
                                    while j < 2048 {
                                        let a = addr_of(j);
                                        w4[0] = byte_of(119);
                                        w4[1] = byte_of(a / 256);
                                        w4[2] = byte_of(a % 256);
                                        w4[3] = byte_of(value_of(j));
                                        let n = exchange(q, pw, w4, ans, 1);
                                        if n != 1 || int_of(ans[0]) != 107 { failures = failures + 1; }
                                        j = j + 1;
                                    }
                                    var bad3 = 0;
                                    j = 0;
                                    while j < 2048 {
                                        let a = addr_of(j);
                                        c3[0] = byte_of(114);
                                        c3[1] = byte_of(a / 256);
                                        c3[2] = byte_of(a % 256);
                                        let n = exchange(q, pw, c3, ans, 1);
                                        if n != 1 || int_of(ans[0]) != value_of(j) { bad3 = bad3 + 1; }
                                        j = j + 1;
                                    }
                                    borrow mut heap as &!h in { borrow mut io as &!i in { say(h, i, "host-driven write and read-back (2048 random addresses): different ", bad3, ""); } }
                                    failures = failures + bad3;
                                }
                            }
                        }
                        tty_close(port);
                    }
                }
            }
            release(device);
            poller_close(p);
        }
    }
    release(io);
    release(heap);
    if status != 0 { return status; }
    if failures != 0 { return 1; }
    return 0;
}
