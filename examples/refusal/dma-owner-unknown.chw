{
  "$schema": "https://alpibrusl/cancho-hdl/spec/contract-schema/cancho-hdl-contract.schema.json",
  "version": "0.1.0",
  "block": {
    "name": "BadDma",
    "base_address": "0x40000000",
    "bus_width": 32,
    "endianness": "little",
    "registers": [
      { "name": "RING_BASE", "offset": "0x00", "kind": "RW" }
    ]
  },
  "dma_buffers": [
    {
      "name": "TxDescriptor",
      "fields": [
        { "name": "next_ptr", "offset": "0x00", "owner": "GPU", "align": 8 }
      ]
    }
  ]
}