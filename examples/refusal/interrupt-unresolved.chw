{
  "$schema": "https://alpibrusl/cancho-hdl/spec/contract-schema/cancho-hdl-contract.schema.json",
  "version": "0.1.0",
  "block": {
    "name": "BadUart",
    "base_address": "0x40000000",
    "bus_width": 32,
    "endianness": "little",
    "registers": [
      { "name": "STATUS", "offset": "0x04", "kind": "RO", "fields": [ { "name": "RX_READY", "lsb": 0, "msb": 0 } ] }
    ],
    "interrupts": [
      {
        "name": "rx_ready",
        "number": 5,
        "source": { "register": "STATUS", "field": "DOES_NOT_EXIST" },
        "enable": { "register": "IER",    "field": "RX_EN" },
        "status": { "register": "ISR",    "field": "RX" },
        "clear":  { "register": "ICR",    "field": "RX" }
      }
    ]
  }
}